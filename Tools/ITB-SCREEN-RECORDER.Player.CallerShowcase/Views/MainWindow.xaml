<Window x:Class="ITB_SCREEN_RECORDER.Player.CallerShowcase.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ITB_SCREEN_RECORDER.Player.CallerShowcase.ViewModels"
        Title="ITB PLAYER — CALLER INTEGRATION SHOWCASE &amp; C2"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="820" Width="1240"
        MinWidth="1050" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:ShowcaseMainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Tactical Header -->
            <RowDefinition Height="54" />
            <!-- Row 1: Main Content 2-Column Split -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- HEADER BAR                                 -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/LogoDark.png" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ITB" Foreground="{StaticResource AccentCyanBrush}" FontWeight="ExtraBold" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="REPLAY DISPATCHER" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="CALLER SHOWCASE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Connection Status Pill -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="IPC STATUS:" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border Background="#1E293B" CornerRadius="4" Padding="10,4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Bold" FontSize="11" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN CONTENT: 2-COLUMN TACTICAL DASHBOARD  -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <!-- Left: Replay Session Configuration & Discovery -->
                <ColumnDefinition Width="480" />
                <!-- Splitter -->
                <ColumnDefinition Width="16" />
                <!-- Right: Live Duplex C2 Remote Deck & Wire Log -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: REPLAY CONFIGURATION -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">

                    <!-- CARD 1: SERVER DISCOVERY -->
                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="1. RECORDING SERVER DISCOVERY" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SelectedServerUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TacticalTextBoxStyle}" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="🔍 SCAN NETWORK" Command="{Binding ScanServersCommand}" Style="{StaticResource TacticalButtonStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding DiscoveryStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: WORKSTATION SELECTION -->
                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="2. WORKSTATIONS" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🔄 QUERY SERVER" Command="{Binding FetchRecordedStationsCommand}" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="8,3" FontSize="10" />
                                <Button Grid.Column="2" Content="ALL" Command="{Binding SelectAllStationsCommand}" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="8,3" FontSize="10" />
                                <Button Grid.Column="3" Content="CLEAR" Command="{Binding ClearAllStationsCommand}" Style="{StaticResource TacticalButtonStyle}" Padding="8,3" FontSize="10" />
                            </Grid>

                            <!-- Station Checklist -->
                            <Border Background="#070A10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Height="110" Padding="6" Margin="0,0,0,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding AvailableStations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected}" Margin="4,3" Cursor="Hand">
                                                    <TextBlock Text="{Binding Hostname}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Add Station Manually -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewStationInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TacticalTextBoxStyle}" Margin="0,0,8,0" Tag="Custom station..." />
                                <Button Grid.Column="1" Content="+ ADD" Command="{Binding AddStationCommand}" Style="{StaticResource TacticalButtonStyle}" Padding="12,4" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: TIME BOUNDS & PRESETS -->
                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="3. SYNCHRONIZED TIME RANGE (UTC)" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />

                            <!-- Presets -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="15 Min" Command="{Binding SetPresetLast15mCommand}" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="4,4" FontSize="10" />
                                <Button Grid.Column="1" Content="30 Min" Command="{Binding SetPresetLast30mCommand}" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="4,4" FontSize="10" />
                                <Button Grid.Column="2" Content="1 Hour" Command="{Binding SetPresetLast1hCommand}" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="4,4" FontSize="10" />
                                <Button Grid.Column="3" Content="4 Hours" Command="{Binding SetPresetLast4hCommand}" Style="{StaticResource TacticalButtonStyle}" Padding="4,4" FontSize="10" />
                            </Grid>

                            <!-- Times -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="START UTC:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
                                <TextBox Grid.Column="1" Text="{Binding StartTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource TacticalTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="END UTC:" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
                                <TextBox Grid.Column="1" Text="{Binding EndTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource TacticalTextBoxStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SEEK UTC:" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" />
                                <TextBox Grid.Column="1" Text="{Binding SeekTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Style="{StaticResource TacticalTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: REPLAY OPTIONS & LAUNCH -->
                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="4. AUDIO &amp; KEYSTROKE OPTIONS" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="SOLO AUDIO:" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3" />
                                    <ComboBox ItemsSource="{Binding SelectedStationNames}" SelectedItem="{Binding SelectedAudioStation}" Background="#070A10" Foreground="#F8FAFC" Padding="6,4" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="KEYSTROKES:" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3" />
                                    <ComboBox SelectedValue="{Binding SelectedKeystrokeMode}" SelectedValuePath="Tag" Background="#070A10" Foreground="#F8FAFC" Padding="6,4">
                                        <ComboBoxItem Content="Burn-In (Hardsub)" Tag="BurnIn" IsSelected="True" />
                                        <ComboBoxItem Content="Caption (SRT)" Tag="Caption" />
                                        <ComboBoxItem Content="None" Tag="None" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Player Path -->
                            <TextBlock Text="ITB PLAYER EXECUTABLE:" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding PlayerExePath}" Style="{StaticResource TacticalTextBoxStyle}" Margin="0,0,6,0" FontSize="10" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowsePlayerExeCommand}" Style="{StaticResource TacticalButtonStyle}" Padding="8,4" FontSize="10" />
                            </Grid>

                            <!-- Launch Button -->
                            <Button Content="🚀 LAUNCH SECURE PLAYER (AES-256-GCM IPC)" Command="{Binding LaunchPlayerCommand}" Style="{StaticResource TacticalAccentButtonStyle}" Padding="16,10" FontSize="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: DUPLEX REMOTE CONTROL & EVENT LOG -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Transport Deck -->
                    <RowDefinition Height="Auto" />
                    <!-- Wire Event Log -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- CARD 1: C2 TRANSPORT DECK -->
                <Border Grid.Row="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="CURRENT PLAYHEAD (LIVE TELEMETRY)" Foreground="{StaticResource TextMutedBrush}" FontWeight="Bold" FontSize="10" />
                                <TextBlock Text="{Binding CurrentPlayheadDisplay}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="ExtraBold" FontSize="22" FontFamily="Consolas" />
                            </StackPanel>

                            <Button Grid.Column="1" Content="■ CLOSE PLAYER" Command="{Binding ClosePlayerCommand}" Style="{StaticResource TacticalButtonStyle}" Padding="12,6" FontSize="11" />
                        </Grid>

                        <!-- Slicing / Download Progress Bar -->
                        <StackPanel Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                            <TextBlock Text="PREPARING MEDIA ON SERVER..." Foreground="{StaticResource AccentAmberBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,3" />
                            <ProgressBar Value="{Binding ExtractionProgressPercent}" Maximum="100" Height="6" Background="#1E293B" Foreground="{StaticResource AccentAmberBrush}" BorderThickness="0" />
                        </StackPanel>

                        <!-- Scrubber Slider -->
                        <Slider Value="{Binding CurrentTimelineSeconds}" Maximum="{Binding TotalDurationSeconds}" Margin="0,0,0,12" Height="22" IsMoveToPointEnabled="True" />

                        <!-- Transport Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Seek Jumps & Play/Pause -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="◀◀ -30s" Command="{Binding SeekRelativeCommand}" CommandParameter="-30" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="8,6" FontSize="11" />
                                <Button Content="◀ -10s" Command="{Binding SeekRelativeCommand}" CommandParameter="-10" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,8,0" Padding="8,6" FontSize="11" />
                                <Button Content="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter='|| PAUSE;▶ PLAY'}" Command="{Binding PlayPauseCommand}" Style="{StaticResource TacticalAccentButtonStyle}" Margin="0,0,8,0" Padding="20,6" FontSize="12" />
                                <Button Content="+10s ▶" Command="{Binding SeekRelativeCommand}" CommandParameter="10" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="8,6" FontSize="11" />
                                <Button Content="+30s ▶▶" Command="{Binding SeekRelativeCommand}" CommandParameter="30" Style="{StaticResource TacticalButtonStyle}" Padding="8,6" FontSize="11" />
                            </StackPanel>

                            <!-- Speed Selectors -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SPEED:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Margin="0,0,6,0" />
                                <Button Content="0.5x" Command="{Binding SetRateCommand}" CommandParameter="0.5" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="6,3" FontSize="10" />
                                <Button Content="1.0x" Command="{Binding SetRateCommand}" CommandParameter="1.0" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="6,3" FontSize="10" />
                                <Button Content="2.0x" Command="{Binding SetRateCommand}" CommandParameter="2.0" Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="6,3" FontSize="10" />
                                <Button Content="4.0x" Command="{Binding SetRateCommand}" CommandParameter="4.0" Style="{StaticResource TacticalButtonStyle}" Padding="6,3" FontSize="10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- CARD 2: REAL-TIME DECRYPTED WIRE EVENT LOG -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="ENCRYPTED DUPLEX IPC WIRE STREAM (DECRYPTED VIEW)" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text="Live real-time telemetry, anti-replay verified events, and command acknowledgements" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#070A10" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding EventLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Foreground="{StaticResource AccentEmeraldBrush}" FontFamily="Consolas" FontSize="11" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
