<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ITB_SCREEN_RECORDER.Player</RootNamespace>
    <ApplicationIcon>..\..\ITB-SCREEN-RECORDER.Core\Assets\Branding\app.ico</ApplicationIcon>
    <Description>ITB Screen Recorder Standalone Player</Description>
  </PropertyGroup>

  <!-- Auto-sync central branding assets from ITB-SCREEN-RECORDER.Core before build -->
  <Target Name="SyncBrandingFromCore" BeforeTargets="BeforeBuild;BeforeRebuild">
    <PropertyGroup>
      <CoreBrandingDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\ITB-SCREEN-RECORDER.Core\Assets\Branding'))</CoreBrandingDir>
    </PropertyGroup>
    <ItemGroup>
      <CoreBrandingFiles Include="$(CoreBrandingDir)\*" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)\Assets" />
    <Copy SourceFiles="@(CoreBrandingFiles)" DestinationFolder="$(MSBuildProjectDirectory)\Assets" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ITB-SCREEN-RECORDER.Player.Core\ITB-SCREEN-RECORDER.Player.Core.csproj" />
    <ProjectReference Include="..\..\ITB-SCREEN-RECORDER.Core\ITB-SCREEN-RECORDER.Core.csproj" />
  </ItemGroup>

  <Target Name="CopyToSolutionPublishWindows" AfterTargets="Build">
    <PropertyGroup>
      <SolutionRoot Condition="'$(SolutionRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..'))</SolutionRoot>
      <PlayerWinPublish>$(SolutionRoot)\Publish\Player\windows\Build</PlayerWinPublish>
    </PropertyGroup>
    <MakeDir Directories="$(PlayerWinPublish)" />
    <ItemGroup>
      <PlayerBuildOutput Include="$(TargetDir)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PlayerBuildOutput)" DestinationFolder="$(PlayerWinPublish)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
