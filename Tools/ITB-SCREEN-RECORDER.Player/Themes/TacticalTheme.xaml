<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tactical NOC Color Palette -->
    <Color x:Key="BgAppColor">#070A10</Color>
    <Color x:Key="SurfacePanelColor">#0F172A</Color>
    <Color x:Key="SurfaceCardColor">#151E2E</Color>
    <Color x:Key="BorderDarkColor">#1E293B</Color>
    <Color x:Key="AccentCyanColor">#06B6D4</Color>
    <Color x:Key="AccentEmeraldColor">#10B981</Color>
    <Color x:Key="AccentRoseColor">#F43F5E</Color>
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgAppBrush" Color="{StaticResource BgAppColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Button Style -->
    <Style x:Key="TacticalButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1E293B" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="#334155" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#334155" />
                            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#0F172A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Accent Button Style -->
    <Style x:Key="TacticalAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource TacticalButtonStyle}">
        <Setter Property="Background" Value="#0284C7" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Secondary Tactical Button Style -->
    <Style x:Key="TacticalSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TacticalButtonStyle}">
        <Setter Property="Background" Value="#0F172A" />
        <Setter Property="BorderBrush" Value="#1E293B" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!-- Slider Style for Timeline & Volume -->
    <Style x:Key="TacticalSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Background" Value="#1E293B" />
    </Style>

</ResourceDictionary>
