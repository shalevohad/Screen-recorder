<Window x:Class="ITB_SCREEN_RECORDER.Player.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ITB_SCREEN_RECORDER.Player.ViewModels"
        Title="ITB PLAYER - Multi-Display Forensic Suite"
        Icon="pack://application:,,,/Assets/app.ico"
        Height="880" Width="1420"
        MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgAppBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown">

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Tactical Top Header Bar (Auto-hides in fullscreen) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Station & Multi-Display Tactical Switcher Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Central Multi-Display Viewport Stage -->
            <RowDefinition Height="*" />
            <!-- Row 3: Collapsible Audio Mixer Dock -->
            <RowDefinition Height="Auto" />
            <!-- Row 4: Master Transport & Timeline Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- ROW 0: TOP TACTICAL COMMAND BAR            -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- System Title & Session Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/LogoDark.png" Height="26" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="ITB" Foreground="{StaticResource AccentCyanBrush}" FontWeight="ExtraBold" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="FORENSIC PLAYER" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0" />

                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" VerticalAlignment="Center"
                            Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SESSION: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding SessionId}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Current Wall-Clock UTC Clock Display -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="CLOCK: " Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentUtcDisplay}" Foreground="{StaticResource AccentCyanBrush}" FontSize="14" FontWeight="Bold" FontFamily="Consolas, monospace" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Command Actions & Drawer Toggles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,8,0"
                            Command="{Binding ToggleAudioMixerCommand}"
                            Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="🔊 AUDIO MIXER" FontSize="11" />
                    </Button>

                    <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,12,0"
                            Command="{Binding ToggleKeystrokeDrawerCommand}"
                            Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⌨ KEYSTROKES" FontSize="11" />
                    </Button>

                    <Button Style="{StaticResource TacticalAccentButtonStyle}" Content="OPEN ARCHIVE..." Command="{Binding OpenFileCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 1: STATION & MULTI-DISPLAY TACTICAL SWITCHER BAR     -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#0C1322" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="16,6"
                Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Station Tabs & Filter Switcher -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                            Command="{Binding SelectAllStationsCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞ ALL STATIONS" FontWeight="Bold" FontSize="11" />
                            <TextBlock Text=" (Grid)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                        </StackPanel>
                    </Button>

                    <ItemsControl ItemsSource="{Binding Stations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="12,5"
                                        Command="{Binding DataContext.SelectStationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖥 " FontSize="11" />
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Display Mode Switcher & Fullscreen Trigger (When station is selected) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Virtual Desktop Topology Canvas -->
                    <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="10,5"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Canvas"
                            ToolTip="Virtual Desktop Canvas: OS physical monitor topology layout (Hotkeys: C or 0)">
                        <TextBlock Text="⊞ CANVAS" FontWeight="Bold" FontSize="11" />
                    </Button>

                    <!-- Split Screen -->
                    <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,6,0" Padding="10,5"
                            Command="{Binding SetViewModeCommand}" CommandParameter="Split"
                            ToolTip="Side-by-side split screen view of station displays (Hotkey: S)">
                        <TextBlock Text="🔲 SPLIT" FontWeight="Bold" FontSize="11" />
                    </Button>

                    <!-- Direct Screen Quick Switchers: 1, 2, ... -->
                    <ItemsControl ItemsSource="{Binding SelectedStation.Displays}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="8,5"
                                        Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding DisplayTitle}">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="11" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Width="1" Background="#1E293B" Margin="6,2" />

                    <!-- Fullscreen Canvas Button -->
                    <Button Style="{StaticResource TacticalAccentButtonStyle}" Margin="4,0,0,0" Padding="12,5"
                            Command="{Binding ToggleFullscreenCanvasCommand}"
                            ToolTip="Toggle Fullscreen Canvas Presentation (Hotkeys: F or F11)">
                        <TextBlock Text="⛶ FULLSCREEN" FontWeight="Bold" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- ROW 2: CENTRAL MULTI-DISPLAY STAGE & KEYSTROKE DRAWER    -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Video Viewport Stage -->
            <Grid Grid.Column="0" Background="{StaticResource BgAppBrush}">

                <!-- Empty State / Drag & Drop Target -->
                <Border Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                        BorderBrush="#1E293B" BorderThickness="2" CornerRadius="8" Margin="32" Background="#0A0F1D">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <TextBlock Text="DRAG &amp; DROP ITB PACKAGE (.TAR / .ITBP)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Zero-extract multi-screen forensic streaming with wall-clock frame synchronization" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" />
                        <Button Style="{StaticResource TacticalAccentButtonStyle}" Content="SELECT FILE..." Command="{Binding OpenFileCommand}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Active Package Replay Viewports -->
                <Grid Visibility="{Binding IsPackageLoaded, Converter={StaticResource BoolToVis}}">

                    <!-- VIEW 1: VIRTUAL DESKTOP TOPOLOGY CANVAS (Proportional real OS monitor bounds) -->
                    <Grid Visibility="{Binding IsCanvasMode, Converter={StaticResource BoolToVis}}" Background="#05070D">
                        <!-- Subtle radar grid background -->
                        <Border BorderBrush="#111B2B" BorderThickness="1" Margin="16">
                            <!-- Responsive Viewbox scales physical canvas coordinates to window size -->
                            <Viewbox Stretch="Uniform" Margin="8">
                                <ItemsControl ItemsSource="{Binding SelectedStation.Displays}"
                                              Width="{Binding SelectedStation.BoundingWidth}"
                                              Height="{Binding SelectedStation.BoundingHeight}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SelectedStation.BoundingWidth}"
                                                    Height="{Binding SelectedStation.BoundingHeight}"
                                                    Background="#070A10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                            <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                                            <Setter Property="Width" Value="{Binding CanvasWidth}" />
                                            <Setter Property="Height" Value="{Binding CanvasHeight}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource SurfaceCardBrush}"
                                                    BorderBrush="{StaticResource AccentCyanBrush}"
                                                    BorderThickness="2" CornerRadius="4" Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="36" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>

                                                    <!-- Monitor Header Overlay -->
                                                    <Border Grid.Row="0" Background="#162032" Padding="12,0" VerticalAlignment="Stretch">
                                                        <Grid VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="ExtraBold" Foreground="{StaticResource AccentCyanBrush}" FontSize="13" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding ResolutionLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontFamily="Consolas, monospace" />
                                                            </StackPanel>
                                                            <TextBlock Text="CLICK TO FOCUS (SOLO)" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" FontWeight="SemiBold" />
                                                        </Grid>
                                                    </Border>

                                                    <!-- Video Surface -->
                                                    <Grid Grid.Row="1" Background="#000000">
                                                        <MediaElement Source="{Binding StreamUrl}"
                                                                      LoadedBehavior="Manual"
                                                                      UnloadedBehavior="Manual"
                                                                      ScrubbingEnabled="True"
                                                                      Stretch="Uniform"
                                                                      Loaded="MediaElement_Loaded"
                                                                      Unloaded="MediaElement_Unloaded" />

                                                        <!-- Gap / No Signal Slate -->
                                                        <Border Background="#E60F172A" Visibility="{Binding IsInGap, Converter={StaticResource BoolToVis}}">
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="⚠ NO SIGNAL - STATION GAP" Foreground="{StaticResource AccentRoseBrush}" FontWeight="ExtraBold" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                                                <TextBlock Text="Synthetic Gap Slate Active" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Subtitle HUD -->
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#CC070A10" CornerRadius="4" Padding="12,6" Margin="0,0,0,16"
                                                                Visibility="{Binding ActiveCaption, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="{Binding ActiveCaption}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" TextAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Viewbox>
                        </Border>

                        <!-- Canvas Legend Badge -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="24" Background="#CC0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞ TOPOLOGY CANVAS" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0" />
                                <TextBlock Text="• Click monitor to focus • Hotkeys: 1-9 switch screens, 0/C returns to canvas" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VIEW 2: SPLIT SCREEN VIEW (Side-by-side station displays) -->
                    <Grid Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}" Background="#070A10" Margin="12">
                        <ItemsControl ItemsSource="{Binding SelectedStation.Displays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Margin="6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="32" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="#162032" Padding="10,0">
                                                <Grid VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding ResolutionLabel}" HorizontalAlignment="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontFamily="Consolas, monospace" />
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1" Background="#000000">
                                                <MediaElement Source="{Binding StreamUrl}" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" Loaded="MediaElement_Loaded" Unloaded="MediaElement_Unloaded" />
                                                <Border Background="#E60F172A" Visibility="{Binding IsInGap, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="⚠ NO SIGNAL" Foreground="{StaticResource AccentRoseBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#CC070A10" CornerRadius="4" Padding="10,4" Margin="0,0,0,12" Visibility="{Binding ActiveCaption, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding ActiveCaption}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" />
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- VIEW 3: SOLO MONITOR VIEW (Single monitor filling 100% viewport) -->
                    <Grid Visibility="{Binding IsSoloMode, Converter={StaticResource BoolToVis}}" Background="#000000">
                        <MediaElement DataContext="{Binding ActiveSoloDisplay}"
                                      Source="{Binding StreamUrl}"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      Loaded="MediaElement_Loaded"
                                      Unloaded="MediaElement_Unloaded" />

                        <!-- No Signal Slate -->
                        <Border DataContext="{Binding ActiveSoloDisplay}" Background="#E60F172A" Visibility="{Binding IsInGap, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚠ NO SIGNAL - STATION GAP" Foreground="{StaticResource AccentRoseBrush}" FontWeight="ExtraBold" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                <TextBlock Text="Gap slate automatically aligned to master timeline" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Subtitle Caption HUD -->
                        <Border DataContext="{Binding ActiveSoloDisplay}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#CC070A10" CornerRadius="4" Padding="14,6" Margin="0,0,0,24"
                                Visibility="{Binding ActiveCaption, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveCaption}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" TextAlignment="Center" />
                        </Border>

                        <!-- Top-Left Navigation Breadcrumb & Back-To-Canvas Action -->
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20" Background="#CC0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="12,6">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedStation.Hostname}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="❯ " Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ActiveSoloDisplay.DisplayTitle}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="12" Margin="0,0,12,0" />
                                <Button Style="{StaticResource TacticalButtonStyle}" Padding="8,3" Command="{Binding ReturnToCanvasCommand}">
                                    <TextBlock Text="⊞ BACK TO CANVAS (Esc)" FontSize="10" FontWeight="Bold" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Bottom-Right Minimap Radar HUD (Interactive monitor switcher) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Background="#CC0F172A" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="TACTICAL MINIMAP" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="10" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedStation.Displays}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource TacticalButtonStyle}" Margin="0,0,4,0" Padding="8,4"
                                                    Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="10" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VIEW 4: ALL STATIONS GRID MODE (Multi-station overview) -->
                    <Grid Visibility="{Binding IsAllGridMode, Converter={StaticResource BoolToVis}}" Background="#070A10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tracks}" Margin="8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Margin="6" Width="580" Height="380">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="32" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <!-- Card Header -->
                                                <Border Grid.Row="0" Background="#1A2234" Padding="10,0" CornerRadius="6,6,0,0">
                                                    <Grid VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Hostname}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                                        </StackPanel>
                                                        <Button HorizontalAlignment="Right" Style="{StaticResource TacticalButtonStyle}" Padding="6,2"
                                                                Command="{Binding DataContext.SelectDisplayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <TextBlock Text="FOCUS ❯" FontSize="10" />
                                                        </Button>
                                                    </Grid>
                                                </Border>

                                                <!-- Video Surface -->
                                                <Grid Grid.Row="1" Background="#000000">
                                                    <MediaElement Source="{Binding StreamUrl}" LoadedBehavior="Manual" UnloadedBehavior="Manual" ScrubbingEnabled="True" Stretch="Uniform" Loaded="MediaElement_Loaded" Unloaded="MediaElement_Unloaded" />
                                                    <Border Background="#E60F172A" Visibility="{Binding IsInGap, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="⚠ NO SIGNAL" Foreground="{StaticResource AccentRoseBrush}" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#B3070A10" CornerRadius="4" Padding="10,4" Margin="0,0,0,16" Visibility="{Binding ActiveCaption, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding ActiveCaption}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" TextAlignment="Center" />
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                </Grid>
            </Grid>

            <!-- Collapsible Keystroke Audit Drawer -->
            <Border Grid.Column="1" Width="360" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsKeystrokeDrawerVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#162032" Padding="12,0" VerticalAlignment="Stretch">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="⌨ KEYSTROKE &amp; ACTIVITY TRAIL" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" FontSize="12" />
                            <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Command="{Binding ToggleKeystrokeDrawerCommand}" />
                        </Grid>
                    </Border>

                    <!-- Search Filter Box -->
                    <Border Grid.Row="1" Padding="8,4" Background="#0F172A">
                        <TextBox Background="#1E293B" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#334155" Padding="6,4" FontSize="12"
                                 Text="{Binding KeystrokeSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <!-- Cues List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Keystrokes}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#151E2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Margin="4,2" Padding="8,6">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SeekToKeystrokeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="{Binding TimeFormatted}" Foreground="{StaticResource AccentCyanBrush}" FontFamily="Consolas, monospace" FontSize="11" FontWeight="Bold" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding StationId}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <Border Background="#F43F5E" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" Visibility="{Binding IsShortcutOrControlKey, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="HOTKEY" Foreground="#FFFFFF" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Text}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- ROW 3: COLLAPSIBLE AUDIO MIXER DOCK        -->
        <!-- ========================================== -->
        <Border Grid.Row="3" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,8"
                Visibility="{Binding IsAudioMixerVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="MULTI-STATION AUDIO MIXER (DISCRETE LOOPBACK / MIC &amp; CROSS-DUCKING)" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Bold" FontSize="11" />
                    <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" Command="{Binding ToggleAudioMixerCommand}" />
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Tracks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,10,0" Width="240">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" Margin="0,0,0,6" />

                                        <!-- Volume Slider -->
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Vol:" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <Slider Minimum="0.0" Maximum="1.0" Value="{Binding Volume}" Style="{StaticResource TacticalSliderStyle}" Margin="30,0,0,0" />
                                        </Grid>

                                        <!-- Pan Slider -->
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Pan:" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                            <Slider Minimum="-1.0" Maximum="1.0" Value="{Binding Pan}" Style="{StaticResource TacticalSliderStyle}" Margin="30,0,0,0" />
                                        </Grid>

                                        <!-- Solo / Mute Toggles -->
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton Grid.Column="0" Content="SOLO" IsChecked="{Binding IsSolo}" Margin="0,0,4,0" Background="#1E293B" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="10" />
                                            <ToggleButton Grid.Column="1" Content="MUTE" IsChecked="{Binding IsMuted}" Margin="4,0,0,0" Background="#1E293B" Foreground="{StaticResource AccentRoseBrush}" FontWeight="Bold" FontSize="10" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- ROW 4: MASTER TRANSPORT & TIMELINE BAR     -->
        <!-- ========================================== -->
        <Border Grid.Row="4" Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top: High-Precision Timeline Scrubber -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0" Minimum="0" Maximum="{Binding TotalDurationSeconds}" Value="{Binding CurrentTimelineSeconds}" Style="{StaticResource TacticalSliderStyle}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1" Text="{Binding CurrentTimelineDisplay}" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="Consolas, monospace" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>

                <!-- Bottom: Transport Controls & Rates -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Step -1f -->
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="◀| -1f" Command="{Binding StepBackwardCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" />

                        <!-- Play / Pause -->
                        <Button Style="{StaticResource TacticalAccentButtonStyle}" Command="{Binding PlayPauseCommand}" Margin="0,0,6,0" Padding="16,4" FontWeight="Bold" FontSize="12">
                            <TextBlock Text="{Binding IsPlaying, Converter={StaticResource BoolToVis}, ConverterParameter='|| PAUSE;▶ PLAY'}" />
                        </Button>

                        <!-- Step +1f -->
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="+1f |▶" Command="{Binding StepForwardCommand}" Margin="0,0,6,0" Padding="8,4" FontSize="11" />

                        <!-- Stop -->
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="■ STOP" Command="{Binding StopCommand}" Margin="0,0,16,0" Padding="8,4" FontSize="11" />

                        <!-- Rate Buttons -->
                        <TextBlock Text="SPEED: " Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontSize="11" FontWeight="Bold" Margin="0,0,6,0" />
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="0.25x" Command="{Binding SetRateCommand}" CommandParameter="0.25" Margin="0,0,4,0" Padding="6,2" FontSize="10" />
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="0.5x" Command="{Binding SetRateCommand}" CommandParameter="0.5" Margin="0,0,4,0" Padding="6,2" FontSize="10" />
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="1.0x" Command="{Binding SetRateCommand}" CommandParameter="1.0" Margin="0,0,4,0" Padding="6,2" FontSize="10" />
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="2.0x" Command="{Binding SetRateCommand}" CommandParameter="2.0" Margin="0,0,4,0" Padding="6,2" FontSize="10" />
                        <Button Style="{StaticResource TacticalButtonStyle}" Content="4.0x" Command="{Binding SetRateCommand}" CommandParameter="4.0" Margin="0,0,4,0" Padding="6,2" FontSize="10" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- REPLAY DISCOVERY & DOWNLOAD OVERLAY        -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Grid.RowSpan="5" Background="#E6070A10"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="1000">
            <Border Background="{StaticResource SurfacePanelBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="32,24" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/LogoDark.png" Height="36" Margin="0,0,0,16" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="PREPARING SYNCHRONIZED REPLAY" Foreground="{StaticResource AccentCyanBrush}" FontWeight="ExtraBold" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding LoadingStatusMessage}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16" TextAlignment="Center" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsLoadingIndeterminate}" Value="{Binding LoadingProgressPercent}" Maximum="100" Height="6" Background="#1E293B" Foreground="{StaticResource AccentCyanBrush}" BorderThickness="0" Margin="0,0,0,16" />
                    <Button Style="{StaticResource TacticalButtonStyle}" Content="CANCEL" Command="{Binding CancelLoadingCommand}" HorizontalAlignment="Center" Padding="20,6" FontSize="11" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
