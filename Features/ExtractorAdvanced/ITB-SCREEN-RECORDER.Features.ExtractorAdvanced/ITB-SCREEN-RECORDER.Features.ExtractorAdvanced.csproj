<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ITB_SCREEN_RECORDER.Features.ExtractorAdvanced</RootNamespace>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

		<!-- מניעת Self-Contained עבור תוסף מודולרי והבטחת נתיב פלט אחיד -->
		<SelfContained>false</SelfContained>
		<AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

		<!-- 💡 השתקת שגיאת NETSDK1152 בכפילויות פלט Publish -->
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>

		<!-- מייצר קובץ .deps.json עבור הפיצ'ר לטעינת תלויות מקומית -->
		<GenerateDependencyFile>true</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Agents\**" />
		<EmbeddedResource Remove="Agents\**" />
		<None Remove="Agents\**" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Client\src\ExtractorAdvancedStudio.jsx~RF1064e574.TMP" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<!-- מטמיע את המניפסט ישירות לתוך ה-DLL המקומפל -->
		<EmbeddedResource Include="feature.json" />
	</ItemGroup>

	<!-- קימפול ה-Widget של ה-Advanced בכל Build (מריץ Vite אוטומטית) -->
	<Target Name="CompileAdvancedFrontend" BeforeTargets="Build" Condition="Exists('Client\package.json')">
		<Message Importance="high" Text="[ITB EXTRACTOR ADVANCED] Building Client Widget..." />
		<Exec Command="npm install" WorkingDirectory="Client" Condition="!Exists('Client\node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="Client" ContinueOnError="false" />
	</Target>

	<!-- הכללת תוצרי ה-Web והמניפסט בפלט ה-Build וה-Publish -->
	<ItemGroup>
		<None Update="wwwroot\**">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			<Visible>true</Visible>
		</None>
		<Content Include="feature.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- ========================================== -->
	<!-- ניהול בינאריים של FFmpeg לפי מערכת הפעלה     -->
	<!-- ========================================== -->

	<!-- עבור Windows: העתקת הכלים מתיקיית Tools/Win לשורש הפלט -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<None Update="Tools\Win\**">
			<TargetPath>%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- עבור Linux: העתקת הכלים מתיקיית Tools/Linux לשורש הפלט -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('linux'))">
		<None Update="Tools/Linux/**">
			<TargetPath>%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Client\src\components\Modals\" />
		<Folder Include="Client\src\components\ExportMonitor\" />
		<Folder Include="Client\src\components\Player\" />
		<Folder Include="Client\src\components\StationDrawer\views\Hub\" />
		<Folder Include="Client\src\components\StationDrawer\views\Drawer\" />
		<Folder Include="Client\src\components\Timeline\export\" />
		<Folder Include="Client\src\components\TransportBar\" />
		<Folder Include="Client\src\components\TopScopeBar\" />
		<Folder Include="Client\src\components\UI\Tactical24HClockPicker\" />
		<Folder Include="Client\src\components\Viewport\utils\" />
		<Folder Include="Tools\Linux\" />
		<Folder Include="Tools\Win\" />
		<Folder Include="Client\public\assets\" />
	</ItemGroup>

	<ItemGroup>
		<!-- Core: משותף ורץ בתהליך המארח (השרת), לכן לא משוכפל -->
		<ProjectReference Include="..\..\..\ITB-SCREEN-RECORDER.Core\ITB-SCREEN-RECORDER.Core.csproj">
			<Private>false</Private>
			<ExcludeAssets>runtime</ExcludeAssets>
		</ProjectReference>

		<!-- 💡 Extractor: נארז עצמאית, ה-DLL מועתק לפלט -->
		<ProjectReference Include="..\..\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj">
			<Private>true</Private>
			<CopyLocalSatelliteAssemblies>true</CopyLocalSatelliteAssemblies>
		</ProjectReference>
	</ItemGroup>

	<!-- ========================================================================= -->
	<!-- סינון חכם של כפילויות Publish (משאיר רק את ה-DLL של Extractor ומונע שגיאת NETSDK1152) -->
	<!-- ========================================================================= -->
	<Target Name="RemoveReferencedExtractorContentDuplicates" BeforeTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<_ExtractorContentFiles1 Include="@(_SourceItemsToCopyToPublishDirectory)" Condition="$([System.String]::Copy('%(_SourceItemsToCopyToPublishDirectory.FullPath)').Replace('\', '/').ToLower().Contains('/features/extractor/')) And '%(_SourceItemsToCopyToPublishDirectory.Extension)' != '.dll' And '%(_SourceItemsToCopyToPublishDirectory.Extension)' != '.pdb'" />
			<_SourceItemsToCopyToPublishDirectory Remove="@(_ExtractorContentFiles1)" />

			<_ExtractorContentFiles2 Include="@(_SourceItemsToCopyToPublishDirectoryAlways)" Condition="$([System.String]::Copy('%(_SourceItemsToCopyToPublishDirectoryAlways.FullPath)').Replace('\', '/').ToLower().Contains('/features/extractor/')) And '%(_SourceItemsToCopyToPublishDirectoryAlways.Extension)' != '.dll' And '%(_SourceItemsToCopyToPublishDirectoryAlways.Extension)' != '.pdb'" />
			<_SourceItemsToCopyToPublishDirectoryAlways Remove="@(_ExtractorContentFiles2)" />
		</ItemGroup>
	</Target>

	<Target Name="FilterDuplicatePublishOutput" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="_CheckForDuplicatePublishOutputFiles">
		<ItemGroup>
			<_DuplicatePublishItems Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Replace('\', '/').ToLower().Contains('/features/extractor/')) And '%(ResolvedFileToPublish.Extension)' != '.dll' And '%(ResolvedFileToPublish.Extension)' != '.pdb'" />
			<ResolvedFileToPublish Remove="@(_DuplicatePublishItems)" />
		</ItemGroup>
	</Target>

	<!-- העתקה אוטומטית של ה-DLL והנכסים לשרת הפיתוח בסיום ה-Build -->
	<Target Name="CopyToDevServer" AfterTargets="Build" Condition="Exists('..\..\..\ITB-SCREEN-RECORDER.Server\bin\Debug\net8.0')">
		<ItemGroup>
			<PluginOutputFiles Include="$(TargetDir)**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="..\..\..\ITB-SCREEN-RECORDER.Server\bin\Debug\net8.0\Features\ExtractorAdvanced\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>