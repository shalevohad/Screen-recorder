# זיהוי אוטומטי של קובצי טקסט ונורמליזציה
* text=auto

# קבצים שחייבים סיומות שורה של לינוקס (LF) בלבד
*.sh text eol=lf
Containerfile text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.container text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# סקריפטים של Windows שדורשים CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# קבצים בינאריים - מניעת שינויים לחלוטין
*.exe binary
*.dll binary
*.rpm binary
*.tar binary
*.gz binary
*.zip binary