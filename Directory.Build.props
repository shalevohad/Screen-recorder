<Project>
  <PropertyGroup>
    <SolutionRoot Condition="'$(SolutionRoot)' == ''">$(MSBuildThisFileDirectory)</SolutionRoot>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Load high-level configuration from agent-kit.config.json if present -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)agent-kit.config.json')">
    <AirGappedBuild Condition="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)agent-kit.config.json').Contains(''airGapped'': true))">true</AirGappedBuild>
    <AirGappedBuild Condition="$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)agent-kit.config.json').Contains(''airGapped'': false))">false</AirGappedBuild>
  </PropertyGroup>

  <!-- Import security analyzers and compile-time gates -->
  <Import Project="$(MSBuildThisFileDirectory).agent-kit\security\security.props" Condition="Exists('$(MSBuildThisFileDirectory).agent-kit\security\security.props')" />
</Project>
