<Project>
  <PropertyGroup>
    <SolutionRoot Condition="'$(SolutionRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</SolutionRoot>
    <Version Condition="'$(Version)' == ''">1.0.44</Version>
    <Company>ITB</Company>
    <Authors>ITB</Authors>
    <Product>ITB Screen Recorder</Product>
    <Copyright>Copyright © ITB 2026</Copyright>
    <AssemblyCompany>ITB</AssemblyCompany>
    <AssemblyProduct>ITB Screen Recorder</AssemblyProduct>
    <AssemblyCopyright>Copyright © ITB 2026</AssemblyCopyright>
  </PropertyGroup>
</Project>
