<Project Sdk="WixToolset.Sdk/5.0.0">
	<PropertyGroup>
		<OutputType>Package</OutputType>
		<Platform>x64</Platform>
		<Platforms>x64</Platforms>

		<!-- נתיב לשורש הפתרון: 3 רמות למעלה מ-Installers/Windows/ITB-SCREEN-RECORDER.Installer -->
		<SolutionRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</SolutionRoot>

		<!-- נרמול גרסה ל-3 מקטעים בלבד (Major.Minor.Build) -->
		<RawVersion Condition="'$(ProductVersion)' != ''">$(ProductVersion)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == '' and '$(Version)' != ''">$(Version)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == ''">1.0.26</RawVersion>

		<Version>$([System.Text.RegularExpressions.Regex]::Match($(RawVersion), '^\d+\.\d+\.\d+').Value)</Version>
		<Version Condition="'$(Version)' == ''">$(RawVersion)</Version>

		<OutputName>ITB-ScreenRecorder-Agent-Setup-$(Version)</OutputName>

		<StagingDir Condition="'$(StagingDir)' == ''">$(SolutionRoot)\Publish\Staging\agent_win</StagingDir>
		<FinalOutputDir Condition="'$(FinalOutputDir)' == ''">$(SolutionRoot)\Publish\Agent\windows</FinalOutputDir>

		<!-- העברת משתנים לקובץ ה-WXS -->
		<DefineConstants>PublishDir=$(StagingDir);Version=$(Version)</DefineConstants>
		<SuppressIces>ICE61</SuppressIces>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="LICENSE-FFMPEG.txt" />
		<Content Include="UpdateAgentSettings.ps1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="License.rtf" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
	</ItemGroup>

	<Target Name="PublishDependenciesBeforeBuild" BeforeTargets="BeforeBuild">
		<Message Importance="high" Text="=== [1/3] Publishing Agent Components to Staging ($(StagingDir)) ===" />
		<RemoveDir Directories="$(StagingDir)" ContinueOnError="true" />
		<MakeDir Directories="$(StagingDir)" />

		<!-- הפיכת ה-Service לעצמאי לחלוטין (Self-Contained) תוך שימוש ב-SolutionRoot -->
		<Exec Command="dotnet publish &quot;$(SolutionRoot)\ITB-SCREEN-RECORDER.AgentService\ITB-SCREEN-RECORDER.AgentService.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(StagingDir)&quot;" />

		<!-- הפיכת ה-Worker לעצמאי לחלוטין (Self-Contained) תוך שימוש ב-SolutionRoot -->
		<Exec Command="dotnet publish &quot;$(SolutionRoot)\ITB-SCREEN-RECORDER.AgentWorker\ITB-SCREEN-RECORDER.AgentWorker.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(StagingDir)&quot;" />
	</Target>

	<Target Name="FinalizeDistributionPackage" AfterTargets="Build">
		<Message Importance="high" Text="=== [2/3] Moving MSI to Distribution Folder ($(FinalOutputDir)) ===" />
		<MakeDir Directories="$(FinalOutputDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FinalOutputDir)" SkipUnchangedFiles="false" />

		<Message Importance="high" Text="=== [3/3] Cleaning up temporary Staging files ===" />
		<RemoveDir Directories="$(StagingDir)" ContinueOnError="true" />
	</Target>

	<Target Name="CleanStagingOnProjectClean" AfterTargets="Clean">
		<RemoveDir Directories="$(StagingDir)" ContinueOnError="true" />
	</Target>
</Project>