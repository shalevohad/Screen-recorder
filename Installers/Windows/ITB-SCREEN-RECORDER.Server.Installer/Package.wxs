<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package Name="ITB Screen Recorder Central Server $(var.Version)"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="6B9A1F82-5C94-4E83-912A-C53E2B66C50C"
			 Scope="perMachine"
			 Compressed="yes"
			 Codepage="65001">

		<MajorUpgrade DowngradeErrorMessage="A newer version is already installed."
              AllowSameVersionUpgrades="yes"
              Schedule="afterInstallValidate" />

		<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
		<MediaTemplate EmbedCab="yes" />

		<!-- 1. עצירת תהליכים מורמת לפני עדכון קבצים -->
		<CustomAction Id="KillServerProcElevated"
					  Directory="System64Folder"
					  ExeCommand="taskkill.exe /F /IM ITB-SCREEN-RECORDER.Server.exe /T"
					  Execute="deferred"
					  Impersonate="no"
					  Return="ignore" />

		<CustomAction Id="KillMediaMtxProcElevated"
					  Directory="System64Folder"
					  ExeCommand="taskkill.exe /F /IM mediamtx.exe /T"
					  Execute="deferred"
					  Impersonate="no"
					  Return="ignore" />

		<!-- 2. הכנת ארגומנטים לעדכון ה-JSON -->
		<CustomAction Id="SetServerJsonDataArgs"
					  Property="UpdateServerJson"
					  Value="[INSTALLFOLDER]|[HTTP_PORT]|[RTMP_PORT]|[API_PORT]|[HLS_PORT]|[DATA_DIR]"
					  Execute="immediate" />

		<!-- 3. הפעלת סקריפט העדכון החיצוני -->
		<CustomAction Id="UpdateServerJson"
					  Directory="System64Folder"
					  ExeCommand="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -WindowStyle Hidden -File &quot;[INSTALLFOLDER]UpdateSettings.ps1&quot; &quot;[UpdateServerJson]&quot;"
					  Execute="deferred"
					  Impersonate="no"
					  Return="ignore" />

		<InstallExecuteSequence>
			<Custom Action="KillServerProcElevated" Before="StopServices" />
			<Custom Action="KillMediaMtxProcElevated" Before="StopServices" />
			<Custom Action="SetServerJsonDataArgs" Before="InstallInitialize" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
			<Custom Action="UpdateServerJson" Before="StartServices" Condition="NOT (REMOVE=&quot;ALL&quot;)" />
		</InstallExecuteSequence>

		<ui:WixUI Id="WixUI_FeatureTree" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<Property Id="HTTP_PORT" Value="5090" />
		<Property Id="RTMP_PORT" Value="19350" />
		<Property Id="API_PORT" Value="9997" />
		<Property Id="HLS_PORT" Value="8888" />
		<Property Id="DATA_DIR" Value="C:\ProgramData\ITB-SCREEN-RECORDER\Server" />

		<UI>
			<Dialog Id="ServerConfigurationDlg" Width="370" Height="270" Title="[ProductName] Setup">
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

				<Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Advanced Server Configuration" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure server ports and data directory." />

				<Control Id="PortLabel" Type="Text" X="20" Y="52" Width="150" Height="15" Text="HTTP Dashboard Port:" />
				<Control Id="PortEdit" Type="Edit" X="180" Y="50" Width="170" Height="18" Property="HTTP_PORT" />

				<Control Id="RtmpLabel" Type="Text" X="20" Y="77" Width="150" Height="15" Text="MediaMTX RTMP Port:" />
				<Control Id="RtmpEdit" Type="Edit" X="180" Y="75" Width="170" Height="18" Property="RTMP_PORT" />

				<Control Id="ApiLabel" Type="Text" X="20" Y="102" Width="150" Height="15" Text="MediaMTX API Port:" />
				<Control Id="ApiEdit" Type="Edit" X="180" Y="100" Width="170" Height="18" Property="API_PORT" />

				<Control Id="HlsLabel" Type="Text" X="20" Y="127" Width="150" Height="15" Text="MediaMTX HLS Port:" />
				<Control Id="HlsEdit" Type="Edit" X="180" Y="125" Width="170" Height="18" Property="HLS_PORT" />

				<Control Id="DataDirLabel" Type="Text" X="20" Y="157" Width="150" Height="15" Text="Data Directory Path:" />
				<Control Id="DataDirEdit" Type="Edit" X="20" Y="172" Width="330" Height="18" Property="DATA_DIR" />

				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="ServerConfigurationDlg" Order="99" Condition="1" />
			<Publish Dialog="ServerConfigurationDlg" Control="Back" Event="NewDialog" Value="CustomizeDlg" Order="99" Condition="1" />
			<Publish Dialog="ServerConfigurationDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="99" Condition="1" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerConfigurationDlg" Order="99" Condition="NOT (WixUI_InstallMode = &quot;Repair&quot; OR WixUI_InstallMode = &quot;Remove&quot;)" />
		</UI>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ITB-ScreenRecorder-Server" />
		</StandardDirectory>

		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="ServerServiceExecutable" Bitness="always64" Guid="D54F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8091">
				<File Id="ServerServiceExe" Source="$(var.ServerDir)\ITB-SCREEN-RECORDER.Server.exe" KeyPath="yes" />
				<ServiceInstall Id="ServiceInstaller"
								Type="ownProcess"
								Name="ITB_ServerService"
								DisplayName="ITB Screen Recorder Central Server"
								Description="Central streaming receiver, telemetry ingestion, and dashboard service."
								Start="auto"
								Account="LocalSystem"
								ErrorControl="normal" />
				<ServiceControl Id="ServiceController"
								Name="ITB_ServerService"
								Start="install"
								Stop="both"
								Remove="uninstall"
								Wait="yes" />
			</Component>

			<!-- שימוש ב-SolutionDir מבטיח איתור מדויק של קובץ הרישיון -->
			<Component Id="MediaMtxLicenseDeclaration" Bitness="always64" Guid="F76B8C9D-0E1F-2A3B-4C5D-6E7F8091A2B3">
				<File Id="MediaMtxLicenseTxt" Source="$(var.RepoRoot)\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" KeyPath="yes" />
			</Component>

			<Component Id="UpdateSettingsScriptComp" Bitness="always64" Guid="C1D2E3F4-A5B6-7C8D-9E0F-1A2B3C4D5E6F">
				<File Id="UpdateSettingsScriptFile" Source="UpdateSettings.ps1" KeyPath="yes" />
			</Component>

			<Files Include="$(var.ServerDir)\**">
				<Exclude Files="$(var.ServerDir)\ITB-SCREEN-RECORDER.Server.exe" />
			</Files>
		</ComponentGroup>

		<Feature Id="MainFeature"
				 Title="ITB Screen Recorder Server"
				 Description="Central streaming receiver, MediaMTX supervisor, telemetry service, and dashboard."
				 Level="1"
				 AllowAbsent="no"
				 Display="expand"
				 ConfigurableDirectory="INSTALLFOLDER">
			<ComponentGroupRef Id="ProductComponents" />

			<!-- קריאה דינמית ל-Features שנוצרו על ידי PowerShell -->
			<FeatureGroupRef Id="DynamicModularFeatures" />
		</Feature>

	</Package>
</Wix>