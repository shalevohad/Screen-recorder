<Project Sdk="WixToolset.Sdk/5.0.0">
	<PropertyGroup>
		<OutputType>Package</OutputType>
		<Platform>x64</Platform>
		<Platforms>x64</Platforms>

		<!-- עוגן מדויק לשורש הפתרון: 3 רמות מעלה מ-Installers/Windows/ITB-SCREEN-RECORDER.Server.Installer -->
		<SolutionRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</SolutionRoot>

		<!-- נרמול גרסה ל-3 מקטעים תקניים -->
		<RawVersion Condition="'$(ProductVersion)' != ''">$(ProductVersion)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == '' and '$(Version)' != ''">$(Version)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == ''">1.0.26</RawVersion>

		<Version>$([System.Text.RegularExpressions.Regex]::Match($(RawVersion), '^\d+\.\d+\.\d+').Value)</Version>
		<Version Condition="'$(Version)' == ''">$(RawVersion)</Version>

		<OutputName>ITB-ScreenRecorder-Server-Setup-$(Version)</OutputName>

		<StagingRoot Condition="'$(StagingRoot)' == ''">$(SolutionRoot)\Publish\Staging</StagingRoot>
		<ServerStaging>$(StagingRoot)\server_root</ServerStaging>
		<FeaturesStaging>$(StagingRoot)\features_root</FeaturesStaging>
		<FinalOutputDir Condition="'$(FinalOutputDir)' == ''">$(SolutionRoot)\Publish\Server\windows</FinalOutputDir>

		<!-- הזרקת משתנים לשימוש בתוך קובצי ה-WXS -->
		<DefineConstants>ServerDir=$(ServerStaging);FeaturesDir=$(FeaturesStaging);Version=$(Version);RepoRoot=$(SolutionRoot)</DefineConstants>

		<SuppressIces>ICE61</SuppressIces>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="$(SolutionRoot)\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" Link="LICENSE-MEDIAMTX.txt" />
		<Content Include="$(SolutionRoot)\ITB-SCREEN-RECORDER.Server\MediaMTX\mediamtx.yml" Link="mediamtx.yml" />
		<Content Include="UpdateSettings.ps1" />
		<Content Include="PublishFeatures.ps1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="License.rtf" />
		<None Include="SelectFeatures.ps1" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
	</ItemGroup>

	<Target Name="PrepareAndGenerateFeaturesBeforeBuild" BeforeTargets="BeforeBuild;BeforeCompile">
		<Message Importance="high" Text="=== [1/3] Preparing Clean Staging Folders ===" />
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
		<MakeDir Directories="$(ServerStaging)" />
		<MakeDir Directories="$(FeaturesStaging)" />
		<MakeDir Directories="$(IntermediateOutputPath)" />

		<Message Importance="high" Text="=== [2/3] Publishing Central Server &amp; Auto-Discovering All Features ===" />
		<Exec Command="dotnet publish &quot;$(SolutionRoot)\ITB-SCREEN-RECORDER.Server\ITB-SCREEN-RECORDER.Server.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(ServerStaging)&quot;" />

		<!-- סניטציה: מחיקת קבצי פיתוח שהסתננו לפלט השרת -->
		<RemoveDir Directories="$(ServerStaging)\Features" ContinueOnError="true" />

		<Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\PublishFeatures.ps1&quot; -FeaturesRoot &quot;$(SolutionRoot)\Features&quot; -StagingDir &quot;$(FeaturesStaging)&quot; -Configuration &quot;$(Configuration)&quot;" />

		<ItemGroup>
			<StrayCoreFiles Include="$(FeaturesStaging)\**\ITB-SCREEN-RECORDER.Core.*" />
		</ItemGroup>
		<Delete Files="@(StrayCoreFiles)" ContinueOnError="true" />

		<Message Importance="high" Text="=== [3/3] Launching Interactive Feature Selection Engine ===" />
		<!-- יצירת הקובץ ישירות בתוך תיקיית obj כדי למנוע סריקה כפולה בשורש הפרויקט -->
		<Exec Command="powershell.exe -Sta -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\SelectFeatures.ps1&quot; -FeaturesDir &quot;$(FeaturesStaging)&quot; -OutputFile &quot;$(IntermediateOutputPath)GeneratedFeatures.wxs&quot;" />

		<!-- הזרקה בלעדית של הקובץ שנוצר ב-obj לקומפילציה -->
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)GeneratedFeatures.wxs" />
		</ItemGroup>
	</Target>

	<Target Name="FinalizeDistributionPackage" AfterTargets="Build">
		<Message Importance="high" Text="=== Moving Final MSI to Distribution Folder ($(FinalOutputDir)) ===" />
		<MakeDir Directories="$(FinalOutputDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FinalOutputDir)" SkipUnchangedFiles="false" />
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
	</Target>

	<Target Name="CleanStagingOnProjectClean" AfterTargets="Clean">
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
		<Delete Files="$(IntermediateOutputPath)GeneratedFeatures.wxs" ContinueOnError="true" />
	</Target>
</Project>