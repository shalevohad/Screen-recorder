<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package Name="ITB Player $(var.Version)"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="C59B1D4E-7E3A-4F98-A12B-0E8C2D4F6A5B"
			 Scope="perMachine"
			 Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of ITB Player is already installed."
					  AllowSameVersionUpgrades="yes"
					  Schedule="afterInstallValidate" />

		<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
		<Property Id="ARPPRODUCTICON" Value="PlayerAppIcon.ico" />
		<MediaTemplate EmbedCab="yes" />

		<!-- Close player instance if running -->
		<util:CloseApplication Target="ITB-SCREEN-RECORDER.Player.exe" CloseMessage="no" RebootPrompt="no" TerminateProcess="1" />

		<!-- Standard UI with License RTF -->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<!-- Directories -->
		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="ITBCompanyFolder" Name="ITB">
				<Directory Id="INSTALLFOLDER" Name="Player" />
			</Directory>
		</StandardDirectory>

		<StandardDirectory Id="ProgramMenuFolder">
			<Directory Id="ApplicationProgramsFolder" Name="ITB" />
		</StandardDirectory>

		<StandardDirectory Id="DesktopFolder" />

		<!-- Components -->
		<ComponentGroup Id="PlayerComponents" Directory="INSTALLFOLDER">
			<!-- 1. Executable and Per-Machine File Associations -->
			<Component Id="PlayerExecutable" Bitness="always64" Guid="D2A4F8B1-6E9C-4D3A-8F0E-1B5C7D9E3A2F">
				<File Id="PlayerExe" Source="$(var.PublishDir)\ITB-SCREEN-RECORDER.Player.exe" KeyPath="yes" />

				<!-- Registry entries for File Associations -->
				<!-- Associate .itbp (ITB Recording Package) -->
				<ProgId Id="ITB.Package" Description="ITB Screen Recording Package">
					<Extension Id="itbp" ContentType="application/x-itb-package">
						<Verb Id="open" Command="Open with ITB Player" TargetFile="PlayerExe" Argument="&quot;%1&quot;" />
					</Extension>
				</ProgId>

				<!-- Context Menu for .tar recording packages -->
				<RegistryKey Root="HKCR" Key="SystemFileAssociations\.tar\shell\OpenWithITBPlayer">
					<RegistryValue Type="string" Value="Open with ITB Player" />
					<RegistryValue Key="command" Type="string" Value="&quot;[#PlayerExe]&quot; &quot;%1&quot;" />
				</RegistryKey>
			</Component>

			<!-- 2. Application Shortcuts (ICE43 & ICE57 Compliant with HKCU KeyPath) -->
			<Component Id="PlayerShortcuts" Directory="ApplicationProgramsFolder" Guid="B1E2D3C4-F5A6-7B8C-9D0E-1F2A3B4C5D6E">
				<Shortcut Id="StartMenuShortcut"
						  Name="ITB Player"
						  Description="ITB Screen Recorder Standalone Player"
						  Target="[#PlayerExe]"
						  WorkingDirectory="INSTALLFOLDER"
						  Icon="PlayerAppIcon.ico" />

				<Shortcut Id="DesktopShortcut"
						  Directory="DesktopFolder"
						  Name="ITB Player"
						  Description="ITB Screen Recorder Standalone Player"
						  Target="[#PlayerExe]"
						  WorkingDirectory="INSTALLFOLDER"
						  Icon="PlayerAppIcon.ico" />

				<RemoveFolder Id="CleanUpProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\ITB\Player" Name="installed" Type="integer" Value="1" KeyPath="yes" />
			</Component>

			<!-- 3. Staged Runtime Dependencies -->
			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ITB-SCREEN-RECORDER.Player.exe" />
			</Files>
		</ComponentGroup>

		<Icon Id="PlayerAppIcon.ico" SourceFile="app.ico" />

		<Feature Id="MainFeature" Title="ITB Player" Level="1">
			<ComponentGroupRef Id="PlayerComponents" />
		</Feature>
	</Package>
</Wix>
