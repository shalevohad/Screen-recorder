[Unit]
Description=ITB Screen Recorder Server Container
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=itb-server
Image=itb-screenrecorder-server:latest
AutoUpdate=none

# מיפוי פורטים
PublishPort=5090:5090
PublishPort=19350:19350
PublishPort=8888:8888
PublishPort=9997:9997

# מיפוי נפחי אחסון וקונפיגורציה
Volume=/var/lib/itb-server/data:/data:Z
Volume=/etc/itb-server/appsettings.json:/app/appsettings.json:ro,Z

# הפעלה מחדש במקרה קריסה
Restart=always

[Service]
RestartSec=10

[Install]
WantedBy=multi-user.target default.target