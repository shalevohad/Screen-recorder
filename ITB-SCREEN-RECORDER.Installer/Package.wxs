<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package Name="ITB Screen Recorder Agent $(var.Version)"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="4F8E6E73-3B82-4E83-942C-B41E1C55B39A"
			 Scope="perMachine"
			 Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of ITB Screen Recorder is already installed."
					  AllowSameVersionUpgrades="yes"
					  Schedule="afterInstallInitialize" />

		<!-- ביטול Restart Manager להתקנות שקטות (Zero-Touch) -->
		<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
		<MediaTemplate EmbedCab="yes" />

		<!-- 1. חיסול שירותים ותהליכים רצים -->
		<CustomAction Id="KillAgentServiceProc" Directory="System64Folder" ExeCommand="taskkill.exe /F /IM ITB-SCREEN-RECORDER.AgentService.exe /T" Execute="immediate" Return="ignore" />
		<CustomAction Id="KillAgentWorker" Directory="System64Folder" ExeCommand="taskkill.exe /F /IM ITB-SCREEN-RECORDER.AgentWorker.exe /T" Execute="immediate" Return="ignore" />

		<!-- 2. אריזת הנתונים לתוך ה-ID של הפעולה הבאה (Immediate) -->
		<CustomAction Id="SetJsonDataArgs"
					  Property="UpdateAgentJson"
					  Value="[INSTALLFOLDER]|[SERVER_IP]"
					  Execute="immediate" />

		<!-- 3. ריצת הסקריפט: עוקף את ה"אכילה" של הסוגריים המרובעים ב-MSI -->
		<CustomAction Id="UpdateAgentJson"
					  Directory="System64Folder"
					  ExeCommand="powershell.exe -ExecutionPolicy Bypass -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;try { $log='C:\Windows\Temp\itb-agent.log'; 'START' | Out-File $log; $d='[UpdateAgentJson]'; $arr=$d.Split('|'); $cleanDir=$arr[0].TrimEnd('\'); $p=Join-Path $cleanDir 'appsettings.json'; $ip=$arr[1]; 'Target File: '+$p+' | IP: '+$ip | Out-File $log -Append; if(-not(Test-Path $p)){ 'File Not Found' | Out-File $log -Append; exit 0 }; $h=if($ip.Contains(':')){$ip.Split(':')[0]}else{$ip}; $c=Get-Content $p -Raw; $q=[\[]char[\]]34; $c=$c -replace ('(?i)'+$q+'DashboardApiUrl'+$q+'\s*:\s*'+$q+'.*?'+$q),($q+'DashboardApiUrl'+$q+': '+$q+'http://'+$h+':5090/api/v1/agent/telemetry'+$q); $c=$c -replace ('(?i)'+$q+'RtmpServerBaseUrl'+$q+'\s*:\s*'+$q+'.*?'+$q),($q+'RtmpServerBaseUrl'+$q+': '+$q+'rtmp://'+$h+':19350/live/'+$q); $c | Set-Content $p -Encoding UTF8; 'SUCCESS' | Out-File $log -Append; exit 0 } catch { 'ERR: '+$_.Exception.Message | Out-File $log -Append; exit 0 }&quot;"
					  Execute="deferred"
					  Impersonate="no"
					  Return="ignore" />

		<InstallExecuteSequence>
			<Custom Action="KillAgentServiceProc" Before="InstallValidate" />
			<Custom Action="KillAgentWorker" Before="InstallValidate" />

			<!-- הזרקת הנתונים למערכת רגע לפני יצירת תסריט ההתקנה -->
			<Custom Action="SetJsonDataArgs" Before="InstallInitialize" Condition="NOT WIX_UPGRADE_DETECTED" />

			<!-- הרצת הסקריפט רק לאחר שהקבצים הועתקו, שנייה לפני הדלקת השירות -->
			<Custom Action="UpdateAgentJson" Before="StartServices" Condition="NOT WIX_UPGRADE_DETECTED" />
		</InstallExecuteSequence>

		<!-- ממשק המשתמש -->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<Property Id="SERVER_IP" Value="127.0.0.1" />

		<UI>
			<Dialog Id="ConfigurationDlg" Width="370" Height="270" Title="[ProductName] Setup">
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

				<Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Agent Configuration" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Enter the IP address or Hostname of the Central ITB Server." />

				<Control Id="IpLabel" Type="Text" X="20" Y="60" Width="330" Height="15" Text="Central Server IP/Host (e.g. 192.168.1.50):" />
				<Control Id="IpEdit" Type="Edit" X="20" Y="75" Width="200" Height="18" Property="SERVER_IP" />

				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ConfigurationDlg" Condition="NOT WIX_UPGRADE_DETECTED" Order="5" />
			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />
			<Publish Dialog="ConfigurationDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" />
			<Publish Dialog="ConfigurationDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ConfigurationDlg" Condition="NOT WIX_UPGRADE_DETECTED" Order="5" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />
		</UI>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ITB-ScreenRecorder" />
		</StandardDirectory>

		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="ServiceExecutable" Bitness="always64" Guid="A21E3D4C-5B6A-7F8E-9D0C-1B2A3F4E5D6C">
				<File Id="ServiceExe" Source="$(var.PublishDir)\ITB-SCREEN-RECORDER.AgentService.exe" KeyPath="yes" />
				<ServiceInstall Id="ServiceInstaller" Type="ownProcess" Name="ITB_AgentService" DisplayName="ITB Screen Recorder Supervisor Service" Description="Supervises interactive screen recording sessions." Start="auto" Account="LocalSystem" ErrorControl="normal" />
				<ServiceControl Id="ServiceController" Name="ITB_AgentService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
			</Component>

			<Component Id="FfmpegLicenseDeclaration" Bitness="always64" Guid="D89A5F6A-7B8C-9D0E-1F2A-3B4C5D6E7F99">
				<File Id="FfmpegLicenseTxt" Source="LICENSE-FFMPEG.txt" KeyPath="yes" />
			</Component>

			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ITB-SCREEN-RECORDER.AgentService.exe" />
			</Files>
		</ComponentGroup>

		<Feature Id="MainFeature" Title="ITB Screen Recorder Agent" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
		</Feature>
	</Package>
</Wix>