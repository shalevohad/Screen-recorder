<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ITB_SCREEN_RECORDER.Server</RootNamespace>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>

		<!-- זיהוי אוטומטי של סביבת הריצה למניעת שגיאות שחזור ב-Linux CI -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">linux-x64</RuntimeIdentifier>

		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
	</PropertyGroup>

	<!-- הגדרות מצב Debug -->
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Features/**" />
		<Content Remove="Features/**" />
		<EmbeddedResource Remove="Features/**" />
		<None Remove="Features/**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="ClientApp/src/components/UI/CommandCenterHeader.jsx~RF168a55cf.TMP" />
		<Content Include="ClientApp/public/css/tailwind.min.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Dapper" Version="2.1.89" />
		<!-- 💡 חבילות SQLite מנוהלות ו-Native Bundle ישיר מ-NuGet -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../ITB-SCREEN-RECORDER.Core/ITB-SCREEN-RECORDER.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ClientApp/src/components/Settings/styles/" />
		<Folder Include="ClientApp/src/components/Settings/tabs/" />
		<Folder Include="ClientApp/src/styles/" />
		<Folder Include="ClientApp\src\Agents\" />
		<Folder Include="Tools\Win\" />
		<Folder Include="Tools\Linux\" />
		<Folder Include="wwwroot/css/" />
	</ItemGroup>

	<!-- ======================================================== -->
	<!-- ניהול קובצי קונפיגורציה לפי יעד מערכת הפעלה               -->
	<!-- ======================================================== -->
	<ItemGroup>
		<None Remove="appsettings.Windows.json" />
		<None Remove="appsettings.Linux.json" />
		<None Remove="appsettings.json" />
	</ItemGroup>

	<!-- בחירת הגדרות Windows ל-Build ול-Publish -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<None Include="appsettings.Windows.json">
			<Link>appsettings.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- בחירת הגדרות Linux ל-Build ול-Publish -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('linux'))">
		<None Include="appsettings.Linux.json">
			<Link>appsettings.json</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- ======================================================== -->
	<!-- ניהול אוטומטי של כלי MediaMTX ו-VC++ לפי מערכת הפעלה     -->
	<!-- ======================================================== -->
	<ItemGroup>
		<None Include="Tools\mediamtx.yml" Condition="Exists('Tools\mediamtx.yml')">
			<TargetPath>MediaMTX\mediamtx.yml</TargetPath>
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
		<None Include="Tools\LICENSE-MEDIAMTX.txt" Condition="Exists('Tools\LICENSE-MEDIAMTX.txt')">
			<TargetPath>MediaMTX\LICENSE-MEDIAMTX.txt</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- התאמות ייעודיות ל-Windows -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<None Include="Tools\Win\*.dll" Condition="Exists('Tools\Win')">
			<TargetPath>%(Filename)%(Extension)</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>

		<None Include="Tools\Win\mediamtx.exe">
			<TargetPath>MediaMTX\mediamtx.exe</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>

		<!-- 💡 העתקת ffprobe עבור שרת Windows -->
		<None Include="Tools\Win\ffprobe.exe" Condition="Exists('Tools\Win\ffprobe.exe')">
			<TargetPath>Tools\Win\ffprobe.exe</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- התאמות ייעודיות ל-Linux -->
	<ItemGroup Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('linux'))">
		<None Include="Tools/Linux/mediamtx">
			<TargetPath>MediaMTX/mediamtx</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>

		<!-- 💡 העתקת ffprobe עבור שרת Linux -->
		<None Include="Tools/Linux/ffprobe" Condition="Exists('Tools/Linux/ffprobe')">
			<TargetPath>Tools/Linux/ffprobe</TargetPath>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<!-- ========================================================================= -->
	<!-- 💡 אוטומציה: חילוץ e_sqlite3.dll / libe_sqlite3.so מ-NuGet לשורש הפלט     -->
	<!-- ========================================================================= -->

	<!-- 1. בעת Publish: שכפול קובץ ה-Native משורת ה-NuGet ישירות לשורש תיקיית ה-Publish -->
	<Target Name="PublishSqliteNativeToRoot" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<_SqliteNativeToPublish Include="@(ResolvedFileToPublish)"
			                        Condition="'%(Filename)' == 'e_sqlite3' or '%(Filename)' == 'libe_sqlite3'" />
			<ResolvedFileToPublish Include="@(_SqliteNativeToPublish)">
				<RelativePath>%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>Always</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
		<Message Importance="high" Text="[SQLITE AUTOMATION] Bundled SQLite Native binary into publish root." />
	</Target>

	<!-- 2. בעת Build רגיל: העתקת ה-DLL לשורש ה-bin להרצה חלקה מ-Visual Studio -->
	<Target Name="CopySqliteNativeToOutputRoot" AfterTargets="CopyFilesToOutputDirectory">
		<ItemGroup>
			<_SqliteNativeBuildFiles Include="@(ReferenceCopyLocalPaths)"
			                         Condition="'%(Filename)' == 'e_sqlite3' or '%(Filename)' == 'libe_sqlite3'" />
		</ItemGroup>
		<Copy SourceFiles="@(_SqliteNativeBuildFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
	</Target>

	<ItemGroup>
		<Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="CompileFrontend" BeforeTargets="Build" Condition="Exists('ClientApp/package.json')">
		<Message Importance="high" Text="[ITB SCREEN RECORDER BUILD] Installing dependencies and building ClientApp..." />
		<Exec Command="npm install" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp/node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="ClientApp" ContinueOnError="true" />
	</Target>

	<!-- ========================================================== -->
	<!-- מערכת לאיתור ובניית Features                               -->
	<!-- ========================================================== -->

	<ItemGroup>
		<FeatureProjects Include="$(MSBuildProjectDirectory)/../Features/*/*/*.csproj" />
		<UpToDateCheckInput Include="$(MSBuildProjectDirectory)/../Features/**/*.*" />
	</ItemGroup>

	<Target Name="BuildFeatureModules" BeforeTargets="BeforeBuild" Condition="'@(FeatureProjects)' != ''">
		<Message Importance="high" Text="[ITB BUILD] Compiling internal Feature modules ($(Configuration))..." />
		<MSBuild Projects="@(FeatureProjects)" Targets="Build" Properties="Configuration=$(Configuration)" />
	</Target>

	<Target Name="StageFeaturesToOutput" AfterTargets="Build" Inputs="@(FeatureProjects)" Outputs="%(Identity).Dummy" Condition="'@(FeatureProjects)' != ''">
		<PropertyGroup>
			<_ProjDir>$([System.IO.Path]::GetDirectoryName('%(FeatureProjects.FullPath)'))</_ProjDir>
			<_FeatureDir>$([System.IO.Path]::GetDirectoryName('$(_ProjDir)'))</_FeatureDir>
			<_FeatureName>$([System.IO.Path]::GetFileName('$(_FeatureDir)'))</_FeatureName>
			<_DestStandard>$(TargetDir)Features\$(_FeatureName)</_DestStandard>
		</PropertyGroup>

		<ItemGroup>
			<_Artifacts Include="$(_ProjDir)\bin\$(Configuration)\net8.0\**\*.*" />
		</ItemGroup>

		<Copy SourceFiles="@(_Artifacts)" DestinationFolder="$(_DestStandard)\%(RecursiveDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
		<Copy SourceFiles="@(_Artifacts)" DestinationFolder="$(TargetDir)$(RuntimeIdentifier)\Features\$(_FeatureName)\%(RecursiveDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" Condition="Exists('$(TargetDir)$(RuntimeIdentifier)')" />
	</Target>

	<Target Name="IncludeFeaturesInPublish" BeforeTargets="PrepareForPublish" Inputs="@(FeatureProjects)" Outputs="%(Identity).Dummy" Condition="'@(FeatureProjects)' != ''">
		<PropertyGroup>
			<_PubProjDir>$([System.IO.Path]::GetDirectoryName('%(FeatureProjects.FullPath)'))</_PubProjDir>
			<_PubFeatureDir>$([System.IO.Path]::GetDirectoryName('$(_PubProjDir)'))</_PubFeatureDir>
			<_PubFeatureName>$([System.IO.Path]::GetFileName('$(_PubFeatureDir)'))</_PubFeatureName>
		</PropertyGroup>

		<ItemGroup>
			<_RawFeatureFiles Include="$(_PubProjDir)\bin\$(Configuration)\net8.0\**\*.*" />
			<ResolvedFileToPublish Include="@(_RawFeatureFiles)">
				<RelativePath>Features\$(_PubFeatureName)\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
		<Message Importance="high" Text="[ITB PUBLISH] Bundling feature module '$(_PubFeatureName)' into publish payload..." />
	</Target>

</Project>