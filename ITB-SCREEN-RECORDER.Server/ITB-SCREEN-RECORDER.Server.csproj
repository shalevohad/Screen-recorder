<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ITB_SCREEN_RECORDER.Server</RootNamespace>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Features\**" />
		<Content Remove="Features\**" />
		<EmbeddedResource Remove="Features\**" />
		<None Remove="Features\**" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="ClientApp\public\css\tailwind.min.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ITB-SCREEN-RECORDER.Core\ITB-SCREEN-RECORDER.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ClientApp\src\components\Settings\styles\" />
		<Folder Include="ClientApp\src\components\Settings\tabs\" />
		<Folder Include="ClientApp\src\styles\" />
		<Folder Include="MediaMTX\" />
		<Folder Include="wwwroot\css\" />
	</ItemGroup>

	<ItemGroup>
		<None Update="MediaMTX\mediamtx.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
		<None Update="MediaMTX\mediamtx.yml">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="CompileFrontend" BeforeTargets="Build" Condition="Exists('ClientApp\package.json')">
		<Message Importance="high" Text="[ITB SCREEN RECORDER BUILD] Installing dependencies and building ClientApp..." />
		<Exec Command="npm install" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp\node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="ClientApp" ContinueOnError="true" />
	</Target>

	<PropertyGroup>
		<ExtractorProjectPath>..\Features\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj</ExtractorProjectPath>
	</PropertyGroup>

	<!-- שחזור ובניית ה-Extractor בנפרד ללא נעילת RuntimeIdentifier -->
	<Target Name="BuildExtractorFeature" BeforeTargets="BeforeBuild" Condition="Exists('$(ExtractorProjectPath)')">
		<Message Importance="high" Text="[ITB BUILD] Restoring and compiling Extractor module ($(Configuration))..." />
		<MSBuild Projects="$(ExtractorProjectPath)"
		         Targets="Restore;Build"
		         Properties="Configuration=$(Configuration);RuntimeIdentifier=" />
	</Target>

	<!-- העתקת קבצים ל-bin בסיום Build רגיל של השרת -->
	<Target Name="StageFeaturesToOutput" AfterTargets="Build" Condition="Exists('$(ExtractorProjectPath)')">
		<ItemGroup>
			<ExtractorOutputFiles Include="..\Features\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\bin\$(Configuration)\net8.0\**\*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ExtractorOutputFiles)"
		      DestinationFolder="$(TargetDir)Features\Extractor\%(RecursiveDir)"
		      SkipUnchangedFiles="true" />
	</Target>

	<!-- שילוב תוצרי ה-Extractor ב-Publish באמצעות Pipeline ה-WebTools הרשמי -->
	<Target Name="IncludeFeaturesInPublish" BeforeTargets="PrepareForPublish" Condition="Exists('$(ExtractorProjectPath)')">
		<ItemGroup>
			<_ExtractorFilesToPublish Include="..\Features\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\bin\$(Configuration)\net8.0\**\*.*" />
			<ResolvedFileToPublish Include="@(_ExtractorFilesToPublish)">
				<RelativePath>Features\Extractor\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
		<Message Importance="high" Text="[ITB PUBLISH] Bundling @(_ExtractorFilesToPublish->Count()) Extractor files into publish payload..." />
	</Target>

</Project>