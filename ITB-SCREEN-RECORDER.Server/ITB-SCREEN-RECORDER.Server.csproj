<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ITB_SCREEN_RECORDER.Server</RootNamespace>
		<ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>

		<!-- זיהוי אוטומטי של סביבת הריצה/Runner למניעת שגיאות שחזור ב-Linux CI -->
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('Windows'))">linux-x64</RuntimeIdentifier>

		<SelfContained>true</SelfContained>
		<PublishSingleFile>false</PublishSingleFile>
		<EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Features/**" />
		<Content Remove="Features/**" />
		<EmbeddedResource Remove="Features/**" />
		<None Remove="Features/**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="ClientApp/src/components/UI/CommandCenterHeader.jsx~RF168a55cf.TMP" />
		<Content Include="ClientApp/public/css/tailwind.min.css" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../ITB-SCREEN-RECORDER.Core/ITB-SCREEN-RECORDER.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="ClientApp/src/components/Settings/styles/" />
		<Folder Include="ClientApp/src/components/Settings/tabs/" />
		<Folder Include="ClientApp/src/styles/" />
		<Folder Include="wwwroot/css/" />
	</ItemGroup>

	<!-- ======================================================== -->
	<!-- העתקה פיזית מלאה של כל תכולת MediaMTX לתיקיית הפלט     -->
	<!-- ======================================================== -->
	<ItemGroup>
		<None Include="MediaMTX\**">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
		<None Update="MediaMTX\mediamtx.yml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<Target Name="CompileFrontend" BeforeTargets="Build" Condition="Exists('ClientApp/package.json')">
		<Message Importance="high" Text="[ITB SCREEN RECORDER BUILD] Installing dependencies and building ClientApp..." />
		<Exec Command="npm install" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp/node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="ClientApp" ContinueOnError="true" />
	</Target>

	<!-- ========================================== -->
	<!-- הגדרות נתיבים עבור הפיצ'רים המודולריים     -->
	<!-- ========================================== -->
	<PropertyGroup>
		<ExtractorProjectPath>../Features/Extractor/ITB-SCREEN-RECORDER.Features.Extractor/ITB-SCREEN-RECORDER.Features.Extractor.csproj</ExtractorProjectPath>
		<ExtractorAdvancedProjectPath>../Features/ExtractorAdvanced/ITB-SCREEN-RECORDER.Features.ExtractorAdvanced/ITB-SCREEN-RECORDER.Features.ExtractorAdvanced.csproj</ExtractorAdvancedProjectPath>
	</PropertyGroup>

	<!-- שחזור ובניית הפיצ'רים מקומית -->
	<Target Name="BuildFeatureModules" BeforeTargets="BeforeBuild">
		<Message Importance="high" Text="[ITB BUILD] Restoring and compiling Extractor module ($(Configuration))..." Condition="Exists('$(ExtractorProjectPath)')" />
		<MSBuild Projects="$(ExtractorProjectPath)" Targets="Restore;Build" Properties="Configuration=$(Configuration);SelfContained=false" Condition="Exists('$(ExtractorProjectPath)')" />

		<Message Importance="high" Text="[ITB BUILD] Restoring and compiling ExtractorAdvanced module ($(Configuration))..." Condition="Exists('$(ExtractorAdvancedProjectPath)')" />
		<MSBuild Projects="$(ExtractorAdvancedProjectPath)" Targets="Restore;Build" Properties="Configuration=$(Configuration);SelfContained=false" Condition="Exists('$(ExtractorAdvancedProjectPath)')" />
	</Target>

	<!-- העתקה שטחית (*.*) בלבד למניעת שכפול מקונן של תיקיות win-x64/ ושגיאות Assembly כפולות -->
	<Target Name="StageFeaturesToOutput" AfterTargets="Build">
		<ItemGroup Condition="Exists('$(ExtractorProjectPath)')">
			<ExtractorOutputFiles Include="../Features/Extractor/ITB-SCREEN-RECORDER.Features.Extractor/bin/$(Configuration)/net8.0/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ExtractorOutputFiles)" DestinationFolder="$(TargetDir)Features/Extractor" SkipUnchangedFiles="true" Condition="Exists('$(ExtractorProjectPath)')" />

		<ItemGroup Condition="Exists('$(ExtractorAdvancedProjectPath)')">
			<ExtractorAdvancedOutputFiles Include="../Features/ExtractorAdvanced/ITB-SCREEN-RECORDER.Features.ExtractorAdvanced/bin/$(Configuration)/net8.0/*.*" />
		</ItemGroup>
		<Copy SourceFiles="@(ExtractorAdvancedOutputFiles)" DestinationFolder="$(TargetDir)Features/ExtractorAdvanced" SkipUnchangedFiles="true" Condition="Exists('$(ExtractorAdvancedProjectPath)')" />
	</Target>

	<!-- אריזת הפיצ'רים לתוך Publish עבור Windows בלבד -->
	<Target Name="IncludeFeaturesInPublish" BeforeTargets="PrepareForPublish" Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<ItemGroup Condition="Exists('$(ExtractorProjectPath)')">
			<_ExtractorFilesToPublish Include="../Features/Extractor/ITB-SCREEN-RECORDER.Features.Extractor/bin/$(Configuration)/net8.0/*.*" />
			<ResolvedFileToPublish Include="@(_ExtractorFilesToPublish)">
				<RelativePath>Features/Extractor/%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>

		<ItemGroup Condition="Exists('$(ExtractorAdvancedProjectPath)')">
			<_ExtractorAdvancedFilesToPublish Include="../Features/ExtractorAdvanced/ITB-SCREEN-RECORDER.Features.ExtractorAdvanced/bin/$(Configuration)/net8.0/*.*" />
			<ResolvedFileToPublish Include="@(_ExtractorAdvancedFilesToPublish)">
				<RelativePath>Features/ExtractorAdvanced/%(FileName)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
		<Message Importance="high" Text="[ITB PUBLISH] Bundling Feature modules into Windows publish payload..." />
	</Target>

</Project>