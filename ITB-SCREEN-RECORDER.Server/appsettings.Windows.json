{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5090"
      }
    }
  },
  "AppConfig": {
    "EnableFileLogging": true,
    "LogFilePath": "C:\\ProgramData\\ITB-SCREEN-RECORDER\\Logs\\Server-Log.txt",
    "LogRetentionDays": 30
  },
  "Database": {
    "BaseDirectory": "C:\\ProgramData\\ITB-SCREEN-RECORDER\\Data",
    "BusyTimeoutSeconds": 5
  },
  "Extractor": {
    "ExportPath": "C:\\ProgramData\\ITB-SCREEN-RECORDER\\Exports",
    "FfmpegPath": "",
    "MaxConcurrentFfmpegProcesses": 4
  },
  "SystemConfig": {
    "RecordingRetentionDays": 30,
    "MaxStorageQuotaGb": 100,
    "DashboardRefreshRateMs": 3000,
    "DefaultVideoBitrate": "2M",
    "DefaultTargetFps": 15,
    "DisplayTimezone": "Asia/Jerusalem",
    "DisplayLocale": "en-US",
    "ManualDstTransitions": [
      {
        "SwitchUtc": "2026-10-24T23:00:00Z",
        "OffsetBeforeMinutes": 180,
        "OffsetAfterMinutes": 120,
        "LabelBefore": "IDT",
        "LabelAfter": "IST",
        "Description": "Winter Clock Transition (Fall Back -1h)"
      },
      {
        "SwitchUtc": "2027-03-26T00:00:00Z",
        "OffsetBeforeMinutes": 120,
        "OffsetAfterMinutes": 180,
        "LabelBefore": "IST",
        "LabelAfter": "IDT",
        "Description": "Summer Clock Transition (Spring Forward +1h)"
      }
    ],
    "Dashboard": {
      "SnapshotMinDelayMs": 1500,
      "SnapshotMaxDelayMs": 4500,
      "SnapshotBufferMarginPx": 250,
      "MaxConcurrentLiveStreams": 9
    },
    "MediaMtx": {
      "ExecutablePath": "MediaMTX\\mediamtx.exe",
      "RtmpPort": 19350,
      "ApiPort": 9997,
      "HlsPort": 8888,
      "PlaybackPort": 9996,
      "MetricsPort": 9998,
      "PprofPort": 9999,
      "EnableMetrics": true,
      "EnablePprof": true,
      "EnablePlayback": true,
      "HlsAlwaysRemux": true,
      "HlsVariant": "fmp4",
      "HlsSegmentDuration": "2s",
      "Timezone": "UTC"
    },
    "Storage": {
      "NetAppUncPath": "\\\\NetAppStorage\\CaptureRecordings",
      "LocalFallbackPath": "C:\\ProgramData\\ITB-SCREEN-RECORDER\\Recordings",
      "ChunkIntervalMinutes": 15,
      "RetentionDays": 30,
      "ChunkEventLogPath": "C:\\ProgramData\\ITB-SCREEN-RECORDER\\Logs\\chunk-events.log",
      "RecordFormat": "fmp4",
      "Bookmarks": {
        "StaleThresholdDays": 30,
        "MaxAllowedStoragePercent": 20.0,
        "PreBufferMinutes": 15,
        "PostBufferMinutes": 15
      }
    },
    "Security": {
      "AllowedAdAdminGroup": "C2_Admins",
      "JwtSecretKey": "YOUR_STRONG_SECRET_KEY_HERE",
      "TokenExpirationHours": 8
    }
  }
}