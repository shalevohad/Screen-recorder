<Project Sdk="WixToolset.Sdk/5.0.0">
	<PropertyGroup>
		<OutputType>Package</OutputType>
		<Platform>x64</Platform>
		<Platforms>x64</Platforms>

		<!-- נרמול גרסה ל-3 מקטעים תקניים -->
		<RawVersion Condition="'$(ProductVersion)' != ''">$(ProductVersion)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == '' and '$(Version)' != ''">$(Version)</RawVersion>
		<RawVersion Condition="'$(RawVersion)' == ''">1.0.24</RawVersion>

		<Version>$([System.Text.RegularExpressions.Regex]::Match($(RawVersion), '^\d+\.\d+\.\d+').Value)</Version>
		<Version Condition="'$(Version)' == ''">$(RawVersion)</Version>

		<OutputName>ITB-ScreenRecorder-Server-Setup-$(Version)</OutputName>

		<StagingRoot Condition="'$(StagingRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Publish\Staging'))</StagingRoot>
		<ServerStaging>$(StagingRoot)\server_root</ServerStaging>
		<FeaturesStaging>$(StagingRoot)\features_root</FeaturesStaging>
		<FinalOutputDir Condition="'$(FinalOutputDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Publish\Server\windows'))</FinalOutputDir>

		<DefineConstants>ServerDir=$(ServerStaging);FeaturesDir=$(FeaturesStaging);Version=$(Version)</DefineConstants>

		<SuppressIces>ICE61</SuppressIces>

		<!-- איתור פרויקט ה-Extractor בדיסק -->
		<ExtractorProj Condition="Exists('$(MSBuildProjectDirectory)\..\Features\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj')">$(MSBuildProjectDirectory)\..\Features\Extractor\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj</ExtractorProj>
		<ExtractorProj Condition="'$(ExtractorProj)' == '' and Exists('$(MSBuildProjectDirectory)\..\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj')">$(MSBuildProjectDirectory)\..\ITB-SCREEN-RECORDER.Features.Extractor\ITB-SCREEN-RECORDER.Features.Extractor.csproj</ExtractorProj>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" />
		<Content Include="..\ITB-SCREEN-RECORDER.Server\MediaMTX\mediamtx.yml" />
		<Content Include="UpdateSettings.ps1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="License.rtf" />
		<None Include="SelectFeatures.ps1" />
		<Compile Remove="GeneratedFeatures.wxs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
	</ItemGroup>

	<Target Name="PrepareAndGenerateFeaturesBeforeBuild" BeforeTargets="BeforeBuild">
		<Message Importance="high" Text="=== [1/4] Preparing Clean Staging Folders ===" />
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
		<MakeDir Directories="$(ServerStaging)" />
		<MakeDir Directories="$(FeaturesStaging)\Extractor" />

		<Message Importance="high" Text="=== [2/4] Publishing Central Server ===" />
		<Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\ITB-SCREEN-RECORDER.Server\ITB-SCREEN-RECORDER.Server.csproj&quot; -c $(Configuration) -r win-x64 --self-contained true -o &quot;$(ServerStaging)&quot;" />

		<!-- 💡 פעולת הסניטציה: מחיקה אגרסיבית של קבצי פיתוח שהסתננו לפלט השרת -->
		<Message Importance="high" Text="=== [Sanitize] Removing stray Features from Server output ===" />
		<RemoveDir Directories="$(ServerStaging)\Features" ContinueOnError="true" />

		<Message Importance="high" Text="=== [3/4] Publishing Extractor Plugin ===" />
		<Exec Command="dotnet publish &quot;$(ExtractorProj)&quot; -c $(Configuration) -r win-x64 --no-self-contained -o &quot;$(FeaturesStaging)\Extractor&quot;" Condition="'$(ExtractorProj)' != '' and Exists('$(ExtractorProj)')" />

		<ItemGroup>
			<StrayCoreFiles Include="$(FeaturesStaging)\**\ITB-SCREEN-RECORDER.Core.*" />
		</ItemGroup>
		<Delete Files="@(StrayCoreFiles)" ContinueOnError="true" />

		<Message Importance="high" Text="=== [4/4] Launching Feature Selection GUI ===" />
		<Exec Command="powershell.exe -Sta -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\SelectFeatures.ps1&quot; -FeaturesDir &quot;$(FeaturesStaging)&quot; -OutputFile &quot;$(MSBuildProjectDirectory)\GeneratedFeatures.wxs&quot;" />
	</Target>

	<Target Name="FinalizeDistributionPackage" AfterTargets="Build">
		<Message Importance="high" Text="=== Moving Final MSI to Distribution Folder ($(FinalOutputDir)) ===" />
		<MakeDir Directories="$(FinalOutputDir)" />
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FinalOutputDir)" SkipUnchangedFiles="false" />
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
	</Target>

	<Target Name="CleanStagingOnProjectClean" AfterTargets="Clean">
		<RemoveDir Directories="$(StagingRoot)" ContinueOnError="true" />
		<Delete Files="$(MSBuildProjectDirectory)\GeneratedFeatures.wxs" ContinueOnError="true" />
	</Target>
</Project>