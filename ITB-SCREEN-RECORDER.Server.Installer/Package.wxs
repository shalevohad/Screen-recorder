<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

	<Package Name="ITB Screen Recorder Central Server"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="6B9A1F82-5C94-4E83-912A-C53E2B66C50C"
			 Scope="perMachine"
			 Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of ITB Screen Recorder Server is already installed." />
		<MediaTemplate EmbedCab="yes" />

		<!-- טעינת ממשק המשתמש הבסיסי -->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

		<!-- הזרקת קובץ הרישיון המותאם (EULA) שכולל את הצהרת השרת ו-MediaMTX -->
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<Property Id="HTTP_PORT" Value="5000" />
		<Property Id="DATA_DIR" Value="C:\ProgramData\ITB-SCREEN-RECORDER\Server" />

		<!-- בניית מסך התצורה המתקדם לשרת ושילובו באשף ההתקנה -->
		<UI>
			<Dialog Id="ServerConfigurationDlg" Width="370" Height="270" Title="[ProductName] Setup">
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

				<Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Advanced Server Configuration" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure server listening port and data directory." />

				<!-- שדה 1: HTTP Port -->
				<Control Id="PortLabel" Type="Text" X="20" Y="60" Width="330" Height="15" Text="HTTP Port:" />
				<Control Id="PortEdit" Type="Edit" X="20" Y="75" Width="330" Height="18" Property="HTTP_PORT" />

				<!-- שדה 2: Data Directory -->
				<Control Id="DataDirLabel" Type="Text" X="20" Y="105" Width="330" Height="15" Text="Data Directory Path:" />
				<Control Id="DataDirEdit" Type="Edit" X="20" Y="120" Width="330" Height="18" Property="DATA_DIR" />

				<!-- כפתורי ניווט -->
				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<!-- חיווט (Routing) של המסך החדש לתוך שרשרת הדיאלוגים של WiX -->
			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerConfigurationDlg" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" Order="5" />
			<Publish Dialog="ServerConfigurationDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" />
			<Publish Dialog="ServerConfigurationDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerConfigurationDlg" Condition="1" Order="5" />
		</UI>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ITB-ScreenRecorder-Server" />
		</StandardDirectory>

		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

			<Component Id="ServerServiceExecutable" Bitness="always64" Guid="D54F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8091">
				<File Id="ServerServiceExe"
					  Source="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe"
					  KeyPath="yes" />

				<ServiceInstall Id="ServiceInstaller"
								Type="ownProcess"
								Name="ITB_ServerService"
								DisplayName="ITB Screen Recorder Central Server"
								Description="Central streaming receiver, telemetry ingestion, and dashboard service."
								Start="auto"
								Account="LocalSystem"
								ErrorControl="normal" />

				<ServiceControl Id="ServiceController"
								Name="ITB_ServerService"
								Start="install"
								Stop="both"
								Remove="uninstall"
								Wait="yes" />
			</Component>

			<Component Id="RegistryConfiguration" Bitness="always64" Guid="E65A7B8C-9D0E-1F2A-3B4C-5D6E7F8091A2">
				<RegistryKey Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer">
					<RegistryValue Name="HttpPort" Value="[HTTP_PORT]" Type="string" KeyPath="yes" />
					<RegistryValue Name="DataDirectory" Value="[DATA_DIR]" Type="string" />
					<RegistryValue Name="InstallPath" Value="[INSTALLFOLDER]" Type="string" />
				</RegistryKey>
			</Component>

			<!-- הטמעת קובץ הרישיון הפיזי של MediaMTX (MIT) כתיעוד משפטי -->
			<Component Id="MediaMtxLicenseDeclaration" Bitness="always64" Guid="F76B8C9D-0E1F-2A3B-4C5D-6E7F8091A2B3">
				<File Id="MediaMtxLicenseTxt" Source="..\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" KeyPath="yes" />
			</Component>

			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe" />
			</Files>

		</ComponentGroup>

		<Feature Id="MainFeature" Title="ITB Screen Recorder Server" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
		</Feature>

	</Package>
</Wix>