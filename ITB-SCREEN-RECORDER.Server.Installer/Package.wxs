<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package Name="ITB Screen Recorder Central Server $(var.Version)"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="6B9A1F82-5C94-4E83-912A-C53E2B66C50C"
			 Scope="perMachine"
			 Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of ITB Screen Recorder Server is already installed."
					  AllowSameVersionUpgrades="yes" />

		<MediaTemplate EmbedCab="yes" />

		<util:CloseApplication Id="CloseServerProcess"
							   Target="ITB-SCREEN-RECORDER.Server.exe"
							   CloseMessage="yes"
							   RebootPrompt="no" />

		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<!-- הגדרת פורט ה-HTTP (Dashboard) -->
		<Property Id="HTTP_PORT">
			<RegistrySearch Id="SearchHttpPort" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="HttpPort" Type="raw" />
		</Property>
		<SetProperty Id="HTTP_PORT" Value="5090" After="AppSearch" Condition="NOT HTTP_PORT" />

		<!-- הגדרת פורט RTMP של MediaMTX (ברירת מחדל 19350) -->
		<Property Id="RTMP_PORT">
			<RegistrySearch Id="SearchRtmpPort" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="RtmpPort" Type="raw" />
		</Property>
		<SetProperty Id="RTMP_PORT" Value="19350" After="AppSearch" Condition="NOT RTMP_PORT" />

		<!-- הגדרת פורט API של MediaMTX (ברירת מחדל 9997) -->
		<Property Id="API_PORT">
			<RegistrySearch Id="SearchApiPort" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="ApiPort" Type="raw" />
		</Property>
		<SetProperty Id="API_PORT" Value="9997" After="AppSearch" Condition="NOT API_PORT" />

		<!-- הגדרת פורט HLS של MediaMTX (ברירת מחדל 8888) -->
		<Property Id="HLS_PORT">
			<RegistrySearch Id="SearchHlsPort" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="HlsPort" Type="raw" />
		</Property>
		<SetProperty Id="HLS_PORT" Value="8888" After="AppSearch" Condition="NOT HLS_PORT" />

		<Property Id="DATA_DIR">
			<RegistrySearch Id="SearchDataDir" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="DataDirectory" Type="raw" />
		</Property>
		<SetProperty Id="DATA_DIR" Value="C:\ProgramData\ITB-SCREEN-RECORDER\Server" After="AppSearch" Condition="NOT DATA_DIR" />

		<Property Id="DEBUG_MODE">
			<RegistrySearch Id="SearchDebugMode" Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer" Name="DebugMode" Type="raw" />
		</Property>
		<SetProperty Id="DEBUG_MODE" Value="0" After="AppSearch" Condition="NOT DEBUG_MODE" />

		<!-- עיצוב מסך ההגדרות המתקדם עם כל שדות הפורטים -->
		<UI>
			<Dialog Id="ServerConfigurationDlg" Width="370" Height="270" Title="[ProductName] Setup">
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

				<Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Advanced Server Configuration" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure server ports and data directory." />

				<!-- שדה 1: HTTP Port -->
				<Control Id="PortLabel" Type="Text" X="20" Y="52" Width="150" Height="15" Text="HTTP Dashboard Port:" />
				<Control Id="PortEdit" Type="Edit" X="180" Y="50" Width="170" Height="18" Property="HTTP_PORT" />

				<!-- שדה 2: RTMP Port -->
				<Control Id="RtmpLabel" Type="Text" X="20" Y="77" Width="150" Height="15" Text="MediaMTX RTMP Port:" />
				<Control Id="RtmpEdit" Type="Edit" X="180" Y="75" Width="170" Height="18" Property="RTMP_PORT" />

				<!-- שדה 3: API Port -->
				<Control Id="ApiLabel" Type="Text" X="20" Y="102" Width="150" Height="15" Text="MediaMTX API Port:" />
				<Control Id="ApiEdit" Type="Edit" X="180" Y="100" Width="170" Height="18" Property="API_PORT" />

				<!-- שדה 4: HLS Port -->
				<Control Id="HlsLabel" Type="Text" X="20" Y="127" Width="150" Height="15" Text="MediaMTX HLS Port:" />
				<Control Id="HlsEdit" Type="Edit" X="180" Y="125" Width="170" Height="18" Property="HLS_PORT" />

				<!-- שדה 5: Data Directory -->
				<Control Id="DataDirLabel" Type="Text" X="20" Y="157" Width="150" Height="15" Text="Data Directory Path:" />
				<Control Id="DataDirEdit" Type="Edit" X="20" Y="172" Width="330" Height="18" Property="DATA_DIR" />

				<!-- כפתורי ניווט -->
				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerConfigurationDlg" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" Order="5" />
			<Publish Dialog="ServerConfigurationDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" />
			<Publish Dialog="ServerConfigurationDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerConfigurationDlg" Condition="1" Order="5" />
		</UI>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ITB-ScreenRecorder-Server" />
		</StandardDirectory>

		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="ServerServiceExecutable" Bitness="always64" Guid="D54F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8091">
				<File Id="ServerServiceExe" Source="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe" KeyPath="yes" />
				<ServiceInstall Id="ServiceInstaller" Type="ownProcess" Name="ITB_ServerService" DisplayName="ITB Screen Recorder Central Server" Description="Central streaming receiver, telemetry ingestion, and dashboard service." Start="auto" Account="LocalSystem" ErrorControl="normal" />
				<ServiceControl Id="ServiceController" Name="ITB_ServerService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
			</Component>

			<!-- שמירת כל הפורטים החדשים לתוך ה-Registry -->
			<Component Id="RegistryConfiguration" Bitness="always64" Guid="E65A7B8C-9D0E-1F2A-3B4C-5D6E7F8091A2">
				<RegistryKey Root="HKLM" Key="SOFTWARE\ITB\ScreenRecorderServer">
					<RegistryValue Name="HttpPort" Value="[HTTP_PORT]" Type="string" KeyPath="yes" />
					<RegistryValue Name="RtmpPort" Value="[RTMP_PORT]" Type="string" />
					<RegistryValue Name="ApiPort" Value="[API_PORT]" Type="string" />
					<RegistryValue Name="HlsPort" Value="[HLS_PORT]" Type="string" />
					<RegistryValue Name="DataDirectory" Value="[DATA_DIR]" Type="string" />
					<RegistryValue Name="InstallPath" Value="[INSTALLFOLDER]" Type="string" />
					<RegistryValue Name="DebugMode" Value="[DEBUG_MODE]" Type="integer" />
				</RegistryKey>
			</Component>

			<Component Id="MediaMtxLicenseDeclaration" Bitness="always64" Guid="F76B8C9D-0E1F-2A3B-4C5D-6E7F8091A2B3">
				<File Id="MediaMtxLicenseTxt" Source="..\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" KeyPath="yes" />
			</Component>

			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe" />
			</Files>
		</ComponentGroup>

		<Feature Id="MainFeature" Title="ITB Screen Recorder Server" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
		</Feature>
	</Package>
</Wix>