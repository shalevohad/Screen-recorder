<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<Package Name="ITB Screen Recorder Central Server $(var.Version)"
			 Manufacturer="ITB"
			 Version="$(var.Version)"
			 UpgradeCode="6B9A1F82-5C94-4E83-912A-C53E2B66C50C"
			 Scope="perMachine"
			 Compressed="yes">

		<MajorUpgrade DowngradeErrorMessage="A newer version of ITB Screen Recorder Server is already installed."
					  AllowSameVersionUpgrades="yes"
					  Schedule="afterInstallInitialize" />

		<Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
		<MediaTemplate EmbedCab="yes" />

		<CustomAction Id="KillServerProc" Directory="System64Folder" ExeCommand="taskkill.exe /F /IM ITB-SCREEN-RECORDER.Server.exe /T" Execute="immediate" Return="ignore" />
		<CustomAction Id="KillMediaMtxProc" Directory="System64Folder" ExeCommand="taskkill.exe /F /IM mediamtx.exe /T" Execute="immediate" Return="ignore" />

		<!-- 💡 עדכון הגדרות השרת ב-JSON באמצעות PowerShell -->
		<SetProperty Id="UpdateServerJson"
					 Value="powershell.exe -NoProfile -NonInteractive -WindowStyle Hidden -Command &quot;try { $p='[INSTALLFOLDER]appsettings.json'; $j=Get-Content $p -Raw | ConvertFrom-Json; $j.Kestrel.Endpoints.Http.Url='http://0.0.0.0:[HTTP_PORT]'; $j.SystemConfig.MediaMtx.RtmpPort=[int]'[RTMP_PORT]'; $j.SystemConfig.MediaMtx.ApiPort=[int]'[API_PORT]'; $j.SystemConfig.MediaMtx.HlsPort=[int]'[HLS_PORT]'; $j.SystemConfig.Storage.LocalFallbackPath='[DATA_DIR]'; $j | ConvertTo-Json -Depth 10 | Set-Content $p } catch { }&quot;"
					 Before="UpdateServerJson"
					 Sequence="execute" />

		<CustomAction Id="UpdateServerJson"
					  Directory="INSTALLFOLDER"
					  ExeCommand="[UpdateServerJson]"
					  Execute="deferred"
					  Impersonate="no"
					  Return="ignore" />

		<InstallExecuteSequence>
			<Custom Action="KillServerProc" Before="InstallValidate" />
			<Custom Action="KillMediaMtxProc" Before="InstallValidate" />
			<!-- הפעלה רק בהתקנה חדשה -->
			<Custom Action="UpdateServerJson" After="InstallFiles" Condition="NOT WIX_UPGRADE_DETECTED" />
		</InstallExecuteSequence>

		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

		<Property Id="HTTP_PORT" Value="5090" />
		<Property Id="RTMP_PORT" Value="19350" />
		<Property Id="API_PORT" Value="9997" />
		<Property Id="HLS_PORT" Value="8888" />
		<Property Id="DATA_DIR" Value="C:\ProgramData\ITB-SCREEN-RECORDER\Server" />

		<UI>
			<Dialog Id="ServerConfigurationDlg" Width="370" Height="270" Title="[ProductName] Setup">
				<Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
				<Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
				<Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

				<Control Id="Title" Type="Text" X="15" Y="6" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Advanced Server Configuration" />
				<Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="15" Transparent="yes" NoPrefix="yes" Text="Configure server ports and data directory." />

				<Control Id="PortLabel" Type="Text" X="20" Y="52" Width="150" Height="15" Text="HTTP Dashboard Port:" />
				<Control Id="PortEdit" Type="Edit" X="180" Y="50" Width="170" Height="18" Property="HTTP_PORT" />

				<Control Id="RtmpLabel" Type="Text" X="20" Y="77" Width="150" Height="15" Text="MediaMTX RTMP Port:" />
				<Control Id="RtmpEdit" Type="Edit" X="180" Y="75" Width="170" Height="18" Property="RTMP_PORT" />

				<Control Id="ApiLabel" Type="Text" X="20" Y="102" Width="150" Height="15" Text="MediaMTX API Port:" />
				<Control Id="ApiEdit" Type="Edit" X="180" Y="100" Width="170" Height="18" Property="API_PORT" />

				<Control Id="HlsLabel" Type="Text" X="20" Y="127" Width="150" Height="15" Text="MediaMTX HLS Port:" />
				<Control Id="HlsEdit" Type="Edit" X="180" Y="125" Width="170" Height="18" Property="HLS_PORT" />

				<Control Id="DataDirLabel" Type="Text" X="20" Y="157" Width="150" Height="15" Text="Data Directory Path:" />
				<Control Id="DataDirEdit" Type="Edit" X="20" Y="172" Width="330" Height="18" Property="DATA_DIR" />

				<Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
				<Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
				<Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
					<Publish Event="SpawnDialog" Value="CancelDlg" />
				</Control>
			</Dialog>

			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ServerConfigurationDlg" Condition="NOT WIX_UPGRADE_DETECTED" Order="5" />
			<Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />

			<Publish Dialog="ServerConfigurationDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" />
			<Publish Dialog="ServerConfigurationDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="1" />

			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ServerConfigurationDlg" Condition="NOT WIX_UPGRADE_DETECTED" Order="5" />
			<Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="WIX_UPGRADE_DETECTED" Order="6" />
		</UI>

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="ITB-ScreenRecorder-Server" />
		</StandardDirectory>

		<ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
			<Component Id="ServerServiceExecutable" Bitness="always64" Guid="D54F6A7B-8C9D-0E1F-2A3B-4C5D6E7F8091">
				<File Id="ServerServiceExe" Source="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe" KeyPath="yes" />
				<ServiceInstall Id="ServiceInstaller" Type="ownProcess" Name="ITB_ServerService" DisplayName="ITB Screen Recorder Central Server" Description="Central streaming receiver, telemetry ingestion, and dashboard service." Start="auto" Account="LocalSystem" ErrorControl="normal" />
				<ServiceControl Id="ServiceController" Name="ITB_ServerService" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
			</Component>

			<Component Id="MediaMtxLicenseDeclaration" Bitness="always64" Guid="F76B8C9D-0E1F-2A3B-4C5D-6E7F8091A2B3">
				<File Id="MediaMtxLicenseTxt" Source="..\ITB-SCREEN-RECORDER.Server\MediaMTX\LICENSE-MEDIAMTX.txt" KeyPath="yes" />
			</Component>

			<Files Include="$(var.PublishDir)\**">
				<Exclude Files="$(var.PublishDir)\ITB-SCREEN-RECORDER.Server.exe" />
			</Files>
		</ComponentGroup>

		<Feature Id="MainFeature" Title="ITB Screen Recorder Server" Level="1">
			<ComponentGroupRef Id="ProductComponents" />
		</Feature>
	</Package>
</Wix>